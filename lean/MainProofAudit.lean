public import Lean.Elab.Command
public import Lean.Util.CollectAxioms

/-! Full transitive audit of the completed theorem. Every local project and
selected Tau Ceti dependency in the import closure is imported with its private
proof bodies. The final type checks forbid any residual mathematical hypothesis. -/
open Lean Elab Command

elab "#audit_completed_main" : command => do
  let env ← getEnv
  let projectRoots := #[`KhanSL2, `BGG, `BGGBridge, `Depth, `Conditional,
    `Deformation, `Macdonald, `StrongMacdonald, `Collision, `KhanSL2All, `MainProof, `ReviewChecks]
  let isProject := fun (n : Name) => projectRoots.any (fun r => r.isPrefixOf n)
  for imported in env.header.modules do
    if (isProject imported.module || (`TauCeti).isPrefixOf imported.module) && !imported.importAll then
      throwError "Private proof bodies missing: {imported.module}"
  for n in #[`KhanSL2.Collision.kFactor, `KhanSL2.mainStatement] do
    match env.find? n with
    | some (.thmInfo _) => pure ()
    | _ => throwError "Expected proved theorem {n}"
  let names := env.constants.toList.filterMap fun (n, info) =>
    let included := match env.getModuleIdxFor? n with
      | some idx => isProject env.header.moduleNames[idx.toNat]!
      | none => false
    if included && !info.isUnsafe then some n else none
  for n in names do
    for ax in (← collectAxioms n) do
      unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
        throwError "Forbidden axiom in {n}: {ax}"
  logInfo m!"PASS: {names.length} safe declarations; complete private-proof closure; no sorryAx or additional axioms."

#check (KhanSL2.Collision.kFactor : ∀ B, KhanSL2.Collision.KFactor B)
#check (KhanSL2.mainStatement : KhanSL2.MainStatement)
#print KhanSL2.mainStatement
#print axioms KhanSL2.Collision.kFactor
#print axioms KhanSL2.mainStatement
#audit_completed_main
