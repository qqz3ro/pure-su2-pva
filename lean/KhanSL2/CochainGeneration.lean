module

public import KhanSL2.CochainSupercomm

@[expose] public section

/-! Homogeneous CE cochains are generated by the finite exterior monomials. -/

noncomputable section

namespace KhanSL2

def modeDegree (m : Mode) : Degree := (1, (m.bCount : ℤ), (m.weight : ℤ))

theorem monomialDegree_insert (m : Mode) (s : ExteriorMonomial) (hm : m ∉ s) :
    monomialDegree (insert m s) = modeDegree m + monomialDegree s := by
  rw [Finset.insert_eq, monomialDegree_union (by simpa using hm)]
  simp [monomialDegree, modeDegree]

theorem cochain_homogeneous_induction {P : Degree → Cochain → Prop}
    (hzero : ∀d, P d 0)
    (hone : P 0 cochainOne)
    (hadd : ∀d u v, P d u → P d v → P d (u + v))
    (hsmul : ∀d (r : ℂ) u, P d u → P d (r • u))
    (hgen : ∀d m u, P d u → P (modeDegree m + d) (wedge (generator m) u))
    {d : Degree} {u : Cochain} (hu : u ∈ cochainPiece d) : P d u := by
  have hmono : ∀s : ExteriorMonomial,
      P (monomialDegree s) (Finsupp.single s 1) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      change P (0, 0, 0) (Finsupp.single ∅ 1) at hone
      simpa only [monomialDegree, Finset.card_empty, Finset.sum_empty,
        Nat.cast_zero] using hone
    | @insert m s hm ih =>
      have h := hgen (monomialDegree s) m (Finsupp.single s 1) ih
      have heq := FiniteExterior.monomial_insert Mode.code m s hm
      change Finsupp.single (insert m s) 1 =
        _ • wedge (generator m) (Finsupp.single s 1) at heq
      rw [monomialDegree_insert m s hm, heq]
      exact hsmul _ _ _ h
  rw [← u.sum_single, Finsupp.sum]
  apply Finset.sum_induction
  · intro a b ha hb
    exact hadd d a b ha hb
  · exact hzero d
  · intro s hs
    have hd : monomialDegree s = d := hu hs
    have h := hsmul (monomialDegree s) (u s) (Finsupp.single s 1) (hmono s)
    simpa only [hd, Finsupp.smul_single, smul_eq_mul, mul_one] using h

end KhanSL2
