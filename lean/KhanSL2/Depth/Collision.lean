module

public import KhanSL2.Depth.GraphRegular
public import Mathlib.RingTheory.Polynomial.Basic
public import Mathlib.Analysis.Complex.Polynomial.Basic

@[expose] public section

/-!
# The ring `R_B` and the full-collision ideal `P_B` (blueprint `lem:collision`)

`R_B = ℂ[t₁, …, t_B]^{S_B}` is presented as the polynomial ring `ℂ[e₁, …, e_B]` in the
elementary symmetric functions (mathlib's `esymmAlgEquiv`); here `RB B = ℂ[X_0, …, X_{B-1}]`
with `X_j = e_{j+1}`.

The full-collision ideal is
`P_B = (e_i - C(B,i) (e₁/B)^i : 2 ≤ i ≤ B)`,
the ideal of the polynomials `(u - a)^B`. Its generators are graph coordinates over `e₁`, so
they form an `R_B`-regular sequence of length `B - 1` (`collisionList_isRegular`).
-/

noncomputable section

open MvPolynomial RingTheory.Sequence

namespace KhanSL2.Depth

/-- `R_B = ℂ[e₁, …, e_B]`; the variable `X j` is `e_{j+1}`. -/
abbrev RB (B : ℕ) : Type := MvPolynomial (Fin B) ℂ

/-- `C(B, j+1) / B^(j+1)`, the coefficient of `e₁^{j+1}` in the generator for `e_{j+1}`. -/
def collisionCoeff (B : ℕ) (j : Fin B) : ℂ :=
  (B.choose ((j : ℕ) + 1) : ℂ) / (B : ℂ) ^ ((j : ℕ) + 1)

/-- The exponent `j + 1`. -/
def collisionExp (B : ℕ) (j : Fin B) : ℕ := (j : ℕ) + 1

/-- The generator `e_{j+1} - C(B, j+1) (e₁/B)^{j+1}` (used for `j ≥ 1`). -/
def collisionGen (B : ℕ) (j : Fin B) : RB B :=
  X j - C (collisionCoeff B j) * X ⟨0, j.pos⟩ ^ ((j : ℕ) + 1)

/-- The generators of `P_B`, in order: `e_i - C(B,i) (e₁/B)^i` for `i = 2, …, B`. -/
def collisionList (B : ℕ) : List (RB B) :=
  ((List.finRange B).filter fun j : Fin B => (j : ℕ) ≠ 0).map (collisionGen B)

/-- **The full-collision ideal** `P_B`. -/
def collisionIdeal (B : ℕ) : Ideal (RB B) := Ideal.ofList (collisionList B)

/-- The generator for `e_{j+1}` is `e_{j+1} - C(B, j+1) (e₁/B)^{j+1}`. -/
theorem collisionGen_eq (B : ℕ) (j : Fin B) :
    collisionGen B j = X j - C ((B.choose ((j : ℕ) + 1) : ℂ)) *
      (C ((1 : ℂ) / B) * X ⟨0, j.pos⟩) ^ ((j : ℕ) + 1) := by
  rw [collisionGen, mul_pow, ← C_pow, ← mul_assoc, ← C_mul, collisionCoeff, one_div, inv_pow,
    div_eq_mul_inv]

theorem collisionGen_mem (B : ℕ) (j : Fin B) (hj : (j : ℕ) ≠ 0) :
    collisionGen B j ∈ collisionList B :=
  List.mem_map_of_mem (List.mem_filter.mpr ⟨List.mem_finRange j, decide_eq_true hj⟩)

theorem mem_collisionList {B : ℕ} {g : RB B} (hg : g ∈ collisionList B) :
    ∃ j : Fin B, (j : ℕ) ≠ 0 ∧ g = collisionGen B j := by
  obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hg
  exact ⟨j, by simpa using (List.mem_filter.mp hj).2, rfl⟩

theorem collisionList_succ (B : ℕ) :
    collisionList (B + 1) = (List.finRange B).map
      (fun j => graphCoord 0 (collisionCoeff (B + 1)) (collisionExp (B + 1)) j.succ) := by
  rw [collisionList, List.finRange_succ, List.filter_cons_of_neg (by simp), List.filter_map,
    List.map_map, List.filter_eq_self.mpr (by simp)]
  rfl

theorem collisionList_length (B : ℕ) : (collisionList B).length = B - 1 := by
  cases B with
  | zero => simp [collisionList]
  | succ B => simp [collisionList_succ]

theorem collisionList_isRegular (B : ℕ) : IsRegular (RB B) (collisionList B) := by
  cases B with
  | zero =>
    have h0 : collisionList 0 = [] := by simp [collisionList]
    rw [h0]
    exact IsRegular.nil (RB 0) (RB 0)
  | succ B =>
    have hfun : (fun j : Fin B => graphCoord 0 (collisionCoeff (B + 1)) (collisionExp (B + 1))
        j.succ) = graphCoord 0 (collisionCoeff (B + 1)) (collisionExp (B + 1)) ∘ Fin.succ := rfl
    rw [collisionList_succ, hfun, ← List.map_map]
    apply graph_isRegular
    · exact (List.nodup_finRange B).map (Fin.succ_injective B)
    · intro h
      obtain ⟨j, _, hj⟩ := List.mem_map.mp h
      exact Fin.succ_ne_zero j hj

/-- `P_B` is generated by an `R_B`-regular sequence of length `B - 1`. -/
theorem collisionIdeal_isRegular (B : ℕ) :
    ∃ rs : List (RB B), Ideal.ofList rs = collisionIdeal B ∧ rs.length = B - 1 ∧
      IsRegular (RB B) rs :=
  ⟨collisionList B, rfl, collisionList_length B, collisionList_isRegular B⟩

end KhanSL2.Depth
