module

public import Mathlib.RingTheory.Depth.Basic
public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.Finiteness.Cardinality
public import Mathlib.RingTheory.Support
public import Mathlib.RingTheory.Finiteness.Ideal

@[expose] public section

/-!
# A depth toolkit

All depths are mathlib's `Ext`-depth `Ideal.depth`, valued in `ℕ∞`. This file collects the
elementary facts used in the depth descent (blueprint `lem:depthkit`):

* the three depth inequalities for a short exact sequence of linear maps
  (`depth_right_ge`, `depth_left_ge`, `depth_middle_ge`), restated from mathlib's
  `ModuleCat.depth_min_*` lemmas for plain linear maps;
* positive depth kills `I`-torsion, and hence torsion by any power of `I`
  (`eq_zero_of_one_le_depth`, `eq_zero_of_one_le_depth_of_pow`);
* if `I` is generated by an `R`-regular sequence of length `c`, every finite projective
  module has depth at least `c` (`length_le_depth_of_projective`).
-/

noncomputable section

universe u

open CategoryTheory RingTheory.Sequence

namespace KhanSL2.Depth

variable {R : Type u} [CommRing R]

/-! ## Short exact sequences -/

section ShortExact

variable {M N L : Type u} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  [AddCommGroup L] [Module R L] (I : Ideal R) {f : M →ₗ[R] N} {g : N →ₗ[R] L}

/-- For `0 → M → N → L → 0`: `depth L ≥ min (depth N, depth M - 1)`. -/
theorem depth_right_ge (hfg : Function.Exact f g) (hf : Function.Injective f)
    (hg : Function.Surjective g) :
    I.depth (ModuleCat.of R N) ⊓ (I.depth (ModuleCat.of R M) - 1) ≤
      I.depth (ModuleCat.of R L) :=
  ModuleCat.depth_min_snd_fst_sub_one_le_trd_right _
    (ModuleCat.shortComplexOfCompEqZero f g hfg.linearMap_comp_eq_zero)
    (ModuleCat.shortComplex_shortExact _ hfg hf hg)

/-- For `0 → M → N → L → 0`: `depth M ≥ min (depth N, depth L + 1)`. -/
theorem depth_left_ge (hfg : Function.Exact f g) (hf : Function.Injective f)
    (hg : Function.Surjective g) :
    I.depth (ModuleCat.of R N) ⊓ (I.depth (ModuleCat.of R L) + 1) ≤
      I.depth (ModuleCat.of R M) :=
  ModuleCat.depth_min_snd_trd_add_one_le_fst_right _
    (ModuleCat.shortComplexOfCompEqZero f g hfg.linearMap_comp_eq_zero)
    (ModuleCat.shortComplex_shortExact _ hfg hf hg)

/-- For `0 → M → N → L → 0`: `depth N ≥ min (depth M, depth L)`. -/
theorem depth_middle_ge (hfg : Function.Exact f g) (hf : Function.Injective f)
    (hg : Function.Surjective g) :
    I.depth (ModuleCat.of R M) ⊓ I.depth (ModuleCat.of R L) ≤ I.depth (ModuleCat.of R N) :=
  ModuleCat.depth_min_fst_trd_le_snd_right _
    (ModuleCat.shortComplexOfCompEqZero f g hfg.linearMap_comp_eq_zero)
    (ModuleCat.shortComplex_shortExact _ hfg hf hg)

end ShortExact

theorem depth_eq_top_of_subsingleton (I : Ideal R) (M : Type u) [AddCommGroup M] [Module R M]
    [Subsingleton M] : I.depth (ModuleCat.of R M) = ⊤ :=
  Ideal.depth_eq_top_of_subsingleton I (ModuleCat.of R M)

/-! ## Torsion -/

/-- **Positive depth kills `I`-torsion** (blueprint `lem:depthkit`(b)). -/
theorem eq_zero_of_one_le_depth {M : Type u} [AddCommGroup M] [Module R M] {I : Ideal R}
    (h : 1 ≤ I.depth (ModuleCat.of R M)) {m : M} (hm : ∀ a ∈ I, a • m = 0) : m = 0 := by
  by_contra hne
  have h0 : I.depth (ModuleCat.of R M) ≠ 0 := by
    intro h0
    rw [h0] at h
    exact absurd h (by norm_num)
  apply h0
  rw [Ideal.depth, ModuleCat.depth_eq_zero_iff_nontrivial_linearMap]
  let φ : (R ⧸ I) →ₗ[R] M := Submodule.liftQ I (LinearMap.toSpanSingleton R M m) (fun a ha => by
    rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
    exact hm a ha)
  let ψ : Shrink.{u} (R ⧸ I) →ₗ[R] M := φ ∘ₗ (Shrink.linearEquiv R (R ⧸ I)).toLinearMap
  refine ⟨⟨ψ, 0, fun hψ => hne ?_⟩⟩
  have h1 := LinearMap.congr_fun hψ ((Shrink.linearEquiv R (R ⧸ I)).symm (Submodule.Quotient.mk 1))
  change φ ((Shrink.linearEquiv R (R ⧸ I)) ((Shrink.linearEquiv R (R ⧸ I)).symm
    (Submodule.Quotient.mk 1))) = 0 at h1
  rw [LinearEquiv.apply_symm_apply] at h1
  change Submodule.liftQ I (LinearMap.toSpanSingleton R M m) _ (Submodule.Quotient.mk 1) = 0 at h1
  rwa [Submodule.liftQ_apply, LinearMap.toSpanSingleton_apply, one_smul] at h1

/-- **Positive depth kills torsion by any power of `I`.** -/
theorem eq_zero_of_one_le_depth_of_pow {M : Type u} [AddCommGroup M] [Module R M] {I : Ideal R}
    (h : 1 ≤ I.depth (ModuleCat.of R M)) (n : ℕ) {m : M} (hm : ∀ a ∈ I ^ n, a • m = 0) :
    m = 0 := by
  induction n generalizing m with
  | zero =>
    have h1 := hm 1 (by simp)
    simpa using h1
  | succ n ih =>
    apply ih
    intro a ha
    apply eq_zero_of_one_le_depth h
    intro b hb
    rw [smul_smul]
    apply hm
    rw [pow_succ, mul_comm b a]
    exact Ideal.mul_mem_mul ha hb

/-- **Support in `V(I)` means torsion by a power of `I`** (blueprint `lem:depthkit`(e)), for
finite modules over a Noetherian ring. -/
theorem exists_pow_smul_eq_zero_of_support_subset [IsNoetherianRing R] {M : Type u}
    [AddCommGroup M] [Module R M] [Module.Finite R M] {I : Ideal R}
    (h : Module.support R M ⊆ PrimeSpectrum.zeroLocus I) :
    ∃ n : ℕ, ∀ a ∈ I ^ n, ∀ m : M, a • m = 0 := by
  rw [Module.support_eq_zeroLocus,
    PrimeSpectrum.zeroLocus_subset_zeroLocus_iff] at h
  obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg h (IsNoetherian.noetherian I)
  exact ⟨n, fun a ha m => Module.mem_annihilator.mp (hn ha) m⟩

/-! ## Depth of finite projective modules -/

/-- Depth of a product is at least the minimum. -/
theorem depth_prod_ge (I : Ideal R) (M N : Type u) [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] :
    I.depth (ModuleCat.of R M) ⊓ I.depth (ModuleCat.of R N) ≤
      I.depth (ModuleCat.of R (M × N)) :=
  depth_middle_ge I Function.Exact.inl_snd LinearMap.inl_injective LinearMap.snd_surjective

/-- A finite free module has at least the depth of the ring. -/
theorem depth_pi_ge (I : Ideal R) {c : ℕ∞} (hR : c ≤ I.depth (ModuleCat.of R R)) :
    ∀ n : ℕ, c ≤ I.depth (ModuleCat.of R (Fin n → R))
  | 0 => by
    rw [depth_eq_top_of_subsingleton]
    exact le_top
  | n + 1 => by
    rw [Ideal.depth_eq_of_linearEquiv I (Fin.consLinearEquiv R (fun _ : Fin (n + 1) => R)).symm]
    exact le_trans (le_inf hR (depth_pi_ge I hR n)) (depth_prod_ge I R (Fin n → R))

/-- **Rees for the ring itself**: a regular sequence generating `I` bounds `depth_I R`. -/
theorem length_le_depth_self [IsNoetherianRing R] {rs : List R} (hrs : IsRegular R rs) :
    (rs.length : ℕ∞) ≤ (Ideal.ofList rs).depth (ModuleCat.of R R) := by
  have hlt : Ideal.ofList rs • (⊤ : Submodule R R) < ⊤ :=
    lt_top_iff_ne_top.mpr hrs.top_ne_smul.symm
  rw [Ideal.depth_eq_sSup_length_isRegular (Ideal.ofList rs) (ModuleCat.of R R) hlt]
  exact le_sSup ⟨rs, hrs, fun r hr => Ideal.subset_span hr, rfl⟩

theorem ENat.le_of_split_inequalities {c x y z : ℕ∞} (hz : c ≤ z) (h1 : z ⊓ (y + 1) ≤ x)
    (h2 : z ⊓ (x + 1) ≤ y) : c ≤ x := by
  by_contra hlt
  push Not at hlt
  have hxz : x < z := lt_of_lt_of_le hlt hz
  have hy : y + 1 ≤ x := by
    rcases le_total z (y + 1) with h | h
    · rw [inf_eq_left.mpr h] at h1
      exact absurd h1 (not_le.mpr hxz)
    · rwa [inf_eq_right.mpr h] at h1
  have hx1 : x + 1 ≤ z := Order.add_one_le_of_lt hxz
  rw [inf_eq_right.mpr hx1] at h2
  have h3 : x + 1 + 1 ≤ x := le_trans (by gcongr) hy
  have hxtop : x ≠ ⊤ := ne_top_of_lt hlt
  lift x to ℕ using hxtop
  norm_cast at h3
  omega

/-- **Finite projective modules have depth at least `c`** when `I` is generated by an
`R`-regular sequence of length `c` (blueprint `lem:depthkit`(a)). -/
theorem length_le_depth_of_projective [IsNoetherianRing R] {rs : List R} (hrs : IsRegular R rs)
    (P : Type u) [AddCommGroup P] [Module R P] [Module.Finite R P] [Module.Projective R P] :
    (rs.length : ℕ∞) ≤ (Ideal.ofList rs).depth (ModuleCat.of R P) := by
  set I := Ideal.ofList rs
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' R P
  obtain ⟨ι, hι⟩ := Module.projective_lifting_property π LinearMap.id hπ
  have hπι (x : P) : π (ι x) = x := LinearMap.congr_fun hι x
  set Q := LinearMap.ker π
  -- `0 → Q → Rⁿ → P → 0`
  have e1 : Function.Exact Q.subtype π := LinearMap.exact_subtype_ker_map π
  -- `0 → P → Rⁿ → Q → 0`
  let g : (Fin n → R) →ₗ[R] Q :=
    LinearMap.codRestrict Q (LinearMap.id - ι ∘ₗ π) (fun x => by
      rw [LinearMap.mem_ker, LinearMap.sub_apply, map_sub, LinearMap.id_apply,
        LinearMap.comp_apply, hπι, sub_self])
  have hg (x : Fin n → R) : (g x : Fin n → R) = x - ι (π x) := rfl
  have hιinj : Function.Injective ι := fun a b h => by
    rw [← hπι a, ← hπι b, h]
  have hgsurj : Function.Surjective g := by
    intro q
    refine ⟨q, Subtype.ext ?_⟩
    rw [hg, LinearMap.mem_ker.mp q.property, map_zero, sub_zero]
  have e2 : Function.Exact ι g := by
    intro x
    constructor
    · intro hx
      refine ⟨π x, ?_⟩
      have h0 := congrArg Subtype.val hx
      rw [hg, ZeroMemClass.coe_zero, sub_eq_zero] at h0
      exact h0.symm
    · rintro ⟨y, rfl⟩
      apply Subtype.ext
      rw [hg, hπι, sub_self, ZeroMemClass.coe_zero]
  have hz : (rs.length : ℕ∞) ≤ I.depth (ModuleCat.of R (Fin n → R)) :=
    depth_pi_ge I (length_le_depth_self hrs) n
  exact ENat.le_of_split_inequalities hz (depth_left_ge I e2 hιinj hgsurj)
    (depth_left_ge I e1 Q.injective_subtype hπ)

end KhanSL2.Depth
