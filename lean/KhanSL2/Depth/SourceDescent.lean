module

public import KhanSL2.Depth.Descent
public import KhanSL2.Depth.SourceDepth

@[expose] public section

/-!
# Depth descent for the source modules (the use in paper §8)

Combine depth descent (Lemma 7.1) with the depth of the source modules (Lemma 7.2): for a
complex of finite projective `R_B`-modules in degrees `0, …, B - 1`, with maps
`H_p → J_{B,p}` surjective for `2 ≤ p < B` and with kernels killed by a power of
`P_B`, those kernels vanish for `2 ≤ p < B`.
Here `P_B` is generated by the regular sequence `collisionList B` of length `B - 1`, and
`depth_{P_B} J_{B,p} ≥ p` for `2 ≤ p ≤ B - 1`.

This is the application to the truncated complex after the top term has been
split off. The target `J_{B,B}` is nonzero, so no surjection from the truncated
homology in degree `B` is assumed. The top-degree isomorphism is a separate step.
-/

noncomputable section

open RingTheory.Sequence

namespace KhanSL2.Depth

/-- **Depth descent for the source modules, after splitting off the top term.** -/
theorem source_kernel_eq_zero (B : ℕ) (C : ℕ → Type) [∀ p, AddCommGroup (C p)]
    [∀ p, Module (RB B) (C p)] [∀ p, Module.Finite (RB B) (C p)]
    [∀ p, Module.Projective (RB B) (C p)]
    (hC : ∀ p, B - 1 < p → Subsingleton (C p))
    (d : ∀ p, C (p + 1) →ₗ[RB B] C p) (hd : ∀ p, (d p).comp (d (p + 1)) = 0)
    (ψ : ∀ p, homology C d p →ₗ[RB B] JB B p)
    (hψ : ∀ p, 2 ≤ p → p < B → Function.Surjective (ψ p))
    (hker : ∀ p, ∃ n : ℕ, ∀ x ∈ LinearMap.ker (ψ p), ∀ a ∈ collisionIdeal B ^ n, a • x = 0) :
    ∀ p : ℕ, 2 ≤ p → p < B → LinearMap.ker (ψ p) = ⊥ := by
  have hk := kernel_eq_zero_of_depth (collisionList_isRegular B)
    (fun p hp => hC p (by rw [collisionList_length] at hp; exact hp)) hd
    (fun p => JB B p) ψ
    (fun p hp2 hpc => hψ p hp2 (by rw [collisionList_length] at hpc; omega)) hker
    (fun p hp2 hpc => by
      rw [collisionList_length] at hpc
      exact depth_JB_ge B p (by omega) (by omega))
  intro p hp _hpB
  exact hk p hp

end KhanSL2.Depth
