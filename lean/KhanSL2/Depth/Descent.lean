module

public import KhanSL2.Depth.Toolkit

@[expose] public section

/-!
# Depth descent (paper Lemma 7.1, blueprint `lem:depthdescent`)

Let `R` be Noetherian and `I` generated by an `R`-regular sequence of length `c`. Let
`C_c → ⋯ → C_0` be a complex of finite projective modules with homology `K_p`, and let
`K_p → J_p` be maps whose kernels are killed by a power of `I`, surjective for
`2 ≤ p ≤ c`. If
`depth_I J_p ≥ p` for `p ≥ 2`, then these kernels vanish for `p ≥ 2`.

The complex is given by modules `C p` and differentials `d p : C (p + 1) → C p`; the homology
`homology C d p` is `ker / im` (with `C 0` all cycles). The proof descends on the cokernels
`T_p = C_p / im d_{p+1}`, keeping `depth_I T_p ≥ p - 1`:
* `T_c = C_c` has depth at least `c`;
* at `p ≥ 2`, positive depth of `T_p ⊇ K_p ⊇ M_p` kills `M_p`, so `K_p ≅ J_p`;
* `0 → K_p → T_p → im d_{p-1} → 0` and `0 → im d_{p-1} → C_{p-1} → T_{p-1} → 0` give
  `depth T_{p-1} ≥ p - 2`.

The paper states the hypothesis `depth_I J_p ≥ p` for all `p > 0`; only `2 ≤ p ≤ c` is used.
Surjectivity is likewise used only in this range. No surjection is required above
the truncated complex, where its homology vanishes but a separately defined target
family may remain nonzero.
-/

noncomputable section

universe u

open CategoryTheory RingTheory.Sequence

namespace KhanSL2.Depth

variable {R : Type u} [CommRing R]
variable (C : ℕ → Type u) [∀ p, AddCommGroup (C p)] [∀ p, Module R (C p)]
  (d : ∀ p, C (p + 1) →ₗ[R] C p)

/-- Cycles of the complex in degree `p` (everything in degree `0`). -/
def cycles : ∀ p, Submodule R (C p)
  | 0 => ⊤
  | p + 1 => LinearMap.ker (d p)

/-- The homology `H_p = Z_p / B_p` of the complex. -/
abbrev homology (p : ℕ) : Type u :=
  ↥(cycles C d p) ⧸ (LinearMap.range (d p)).comap (cycles C d p).subtype

/-- The cokernel `T_p = C_p / B_p`. -/
abbrev coker (p : ℕ) : Type u := C p ⧸ LinearMap.range (d p)

/-- Homology sits inside the cokernel. -/
def homologyToCoker (p : ℕ) : homology C d p →ₗ[R] coker C d p :=
  Submodule.mapQ _ _ (cycles C d p).subtype le_rfl

theorem homologyToCoker_injective (p : ℕ) : Function.Injective (homologyToCoker C d p) := by
  rw [← LinearMap.ker_eq_bot, homologyToCoker, Submodule.ker_mapQ, Submodule.mkQ_map_self]

theorem homologyToCoker_mk (p : ℕ) (x : cycles C d p) :
    homologyToCoker C d p (Submodule.Quotient.mk x) = Submodule.Quotient.mk (x : C p) := rfl

variable {C d}

/-- The map `T_{p+1} → im d_p` induced by `d_p`. -/
def cokerToRange (hd : ∀ p, (d p).comp (d (p + 1)) = 0) (p : ℕ) :
    coker C d (p + 1) →ₗ[R] LinearMap.range (d p) :=
  (LinearMap.range (d (p + 1))).liftQ (d p).rangeRestrict (by
    rintro _ ⟨y, rfl⟩
    rw [LinearMap.mem_ker]
    apply Subtype.ext
    rw [LinearMap.codRestrict_apply, ZeroMemClass.coe_zero]
    exact LinearMap.congr_fun (hd p) y)

theorem cokerToRange_mk (hd : ∀ p, (d p).comp (d (p + 1)) = 0) (p : ℕ) (x : C (p + 1)) :
    (cokerToRange hd p (Submodule.Quotient.mk x) : C p) = d p x := rfl

theorem cokerToRange_surjective (hd : ∀ p, (d p).comp (d (p + 1)) = 0) (p : ℕ) :
    Function.Surjective (cokerToRange hd p) := by
  rintro ⟨_, ⟨x, rfl⟩⟩
  exact ⟨Submodule.Quotient.mk x, Subtype.ext rfl⟩

/-- `0 → K_{p+1} → T_{p+1} → im d_p → 0` is exact. -/
theorem exact_homologyToCoker_cokerToRange (hd : ∀ p, (d p).comp (d (p + 1)) = 0) (p : ℕ) :
    Function.Exact (homologyToCoker C d (p + 1)) (cokerToRange hd p) := by
  intro t
  induction t using Submodule.Quotient.induction_on with
  | H x =>
    constructor
    · intro hx
      have hx' : d p x = 0 := by
        have := congrArg Subtype.val hx
        rwa [cokerToRange_mk, ZeroMemClass.coe_zero] at this
      exact ⟨Submodule.Quotient.mk ⟨x, hx'⟩, rfl⟩
    · rintro ⟨k, hk⟩
      induction k using Submodule.Quotient.induction_on with
      | H c =>
        rw [homologyToCoker_mk, Submodule.Quotient.eq] at hk
        obtain ⟨y, hy⟩ := hk
        apply Subtype.ext
        rw [cokerToRange_mk, ZeroMemClass.coe_zero]
        have hc : d p (c : C (p + 1)) = 0 := c.property
        have h2 : d p (d (p + 1) y) = 0 := LinearMap.congr_fun (hd p) y
        have : x = (c : C (p + 1)) - d (p + 1) y := by rw [hy]; abel
        rw [this, map_sub, hc, h2, sub_zero]

/-! ## The descent -/

variable {rs : List R}

/-- If `T_p` has positive depth, the kernel of `K_p → J_p` vanishes. -/
theorem ker_eq_bot_of_one_le_depth {J : Type u} [AddCommGroup J] [Module R J] {p : ℕ}
    (f : homology C d p →ₗ[R] J)
    (hker : ∃ n : ℕ, ∀ x ∈ LinearMap.ker f, ∀ a ∈ Ideal.ofList rs ^ n, a • x = 0)
    (hT : 1 ≤ (Ideal.ofList rs).depth (ModuleCat.of R (coker C d p))) :
    LinearMap.ker f = ⊥ := by
  obtain ⟨n, hn⟩ := hker
  rw [eq_bot_iff]
  intro x hx
  rw [Submodule.mem_bot]
  apply homologyToCoker_injective C d p
  rw [map_zero]
  apply eq_zero_of_one_le_depth_of_pow hT n
  intro a ha
  rw [← map_smul, hn x hx a ha, map_zero]

theorem enat_natCast_sub_one (p : ℕ) : ((p + 1 : ℕ) : ℕ∞) - 1 = p := by
  simp

variable [IsNoetherianRing R]

/-- **Depth descent (paper Lemma 7.1).** -/
theorem kernel_eq_zero_of_depth (hrs : IsRegular R rs)
    [∀ p, Module.Finite R (C p)] [∀ p, Module.Projective R (C p)]
    (hC : ∀ p, rs.length < p → Subsingleton (C p))
    (hd : ∀ p, (d p).comp (d (p + 1)) = 0)
    (J : ℕ → Type u) [∀ p, AddCommGroup (J p)] [∀ p, Module R (J p)]
    (f : ∀ p, homology C d p →ₗ[R] J p)
    (hf : ∀ p, 2 ≤ p → p ≤ rs.length → Function.Surjective (f p))
    (hker : ∀ p, ∃ n : ℕ, ∀ x ∈ LinearMap.ker (f p), ∀ a ∈ Ideal.ofList rs ^ n, a • x = 0)
    (hJ : ∀ p : ℕ, 2 ≤ p → p ≤ rs.length →
      (p : ℕ∞) ≤ (Ideal.ofList rs).depth (ModuleCat.of R (J p))) :
    ∀ p : ℕ, 2 ≤ p → LinearMap.ker (f p) = ⊥ := by
  set I := Ideal.ofList rs
  set c := rs.length
  have hCdepth (p : ℕ) : (c : ℕ∞) ≤ I.depth (ModuleCat.of R (C p)) :=
    length_le_depth_of_projective hrs (C p)
  -- the bound at and above the top degree
  have base (p : ℕ) (hp : c ≤ p) : (p : ℕ∞) - 1 ≤ I.depth (ModuleCat.of R (coker C d p)) := by
    rcases hp.lt_or_eq with hlt | heq
    · have : Subsingleton (C p) := hC p hlt
      rw [depth_eq_top_of_subsingleton]
      exact le_top
    · subst heq
      have : Subsingleton (C (c + 1)) := hC (c + 1) (Nat.lt_succ_self c)
      have hrange : LinearMap.range (d c) = ⊥ := by
        rw [eq_bot_iff]
        rintro _ ⟨y, rfl⟩
        rw [Subsingleton.elim y 0, map_zero]
        exact Submodule.zero_mem _
      rw [Ideal.depth_eq_of_linearEquiv I (Submodule.quotEquivOfEqBot _ hrange)]
      exact le_trans tsub_le_self (hCdepth c)
  -- one step of the descent
  have step (p : ℕ) (hp : 1 ≤ p) (hpc : p < c)
      (ih : ((p + 1 : ℕ) : ℕ∞) - 1 ≤ I.depth (ModuleCat.of R (coker C d (p + 1)))) :
      (p : ℕ∞) - 1 ≤ I.depth (ModuleCat.of R (coker C d p)) := by
    rw [enat_natCast_sub_one] at ih
    have hT : 1 ≤ I.depth (ModuleCat.of R (coker C d (p + 1))) :=
      le_trans (by exact_mod_cast hp) ih
    have hk : LinearMap.ker (f (p + 1)) = ⊥ := ker_eq_bot_of_one_le_depth (f (p + 1))
      (hker (p + 1)) hT
    let e : homology C d (p + 1) ≃ₗ[R] J (p + 1) :=
      LinearEquiv.ofBijective (f (p + 1)) ⟨LinearMap.ker_eq_bot.mp hk, hf (p + 1) (by omega) (by omega)⟩
    have hK : ((p + 1 : ℕ) : ℕ∞) ≤ I.depth (ModuleCat.of R (homology C d (p + 1))) := by
      rw [Ideal.depth_eq_of_linearEquiv I e]
      exact hJ (p + 1) (by omega) (by omega)
    -- `0 → K_{p+1} → T_{p+1} → im d_p → 0`
    have hIm : (p : ℕ∞) ≤ I.depth (ModuleCat.of R (LinearMap.range (d p))) := by
      refine le_trans ?_ (depth_right_ge I (exact_homologyToCoker_cokerToRange hd p)
        (homologyToCoker_injective C d (p + 1)) (cokerToRange_surjective hd p))
      refine le_inf ih ?_
      rw [← enat_natCast_sub_one p]
      exact tsub_le_tsub_right hK 1
    -- `0 → im d_p → C_p → T_p → 0`
    refine le_trans ?_ (depth_right_ge I (LinearMap.exact_subtype_mkQ (LinearMap.range (d p)))
      (Submodule.injective_subtype _) (Submodule.mkQ_surjective _))
    refine le_inf (le_trans tsub_le_self (le_trans (by exact_mod_cast hpc.le) (hCdepth p))) ?_
    exact tsub_le_tsub_right hIm 1
  -- the descent
  have desc : ∀ k p, c - p = k → 1 ≤ p →
      (p : ℕ∞) - 1 ≤ I.depth (ModuleCat.of R (coker C d p)) := by
    intro k
    induction k with
    | zero =>
      intro p hk _
      exact base p (by omega)
    | succ k ih =>
      intro p hk hp
      exact step p hp (by omega) (ih (p + 1) (by omega) (by omega))
  intro p hp
  apply ker_eq_bot_of_one_le_depth (f p) (hker p)
  have h := desc (c - p) p rfl (by omega)
  refine le_trans ?_ h
  obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
  rw [enat_natCast_sub_one]
  exact_mod_cast (by omega : 1 ≤ q)

/-- **Depth descent, in the paper's form**: the kernels are only assumed to be supported on
`V(I)`; they are finite because the complex is. -/
theorem kernel_eq_zero_of_depth_of_support (hrs : IsRegular R rs)
    [∀ p, Module.Finite R (C p)] [∀ p, Module.Projective R (C p)]
    (hC : ∀ p, rs.length < p → Subsingleton (C p))
    (hd : ∀ p, (d p).comp (d (p + 1)) = 0)
    (J : ℕ → Type u) [∀ p, AddCommGroup (J p)] [∀ p, Module R (J p)]
    (f : ∀ p, homology C d p →ₗ[R] J p)
    (hf : ∀ p, 2 ≤ p → p ≤ rs.length → Function.Surjective (f p))
    (hsupp : ∀ p, Module.support R (LinearMap.ker (f p)) ⊆
      PrimeSpectrum.zeroLocus (Ideal.ofList rs))
    (hJ : ∀ p : ℕ, 2 ≤ p → p ≤ rs.length →
      (p : ℕ∞) ≤ (Ideal.ofList rs).depth (ModuleCat.of R (J p))) :
    ∀ p : ℕ, 2 ≤ p → LinearMap.ker (f p) = ⊥ := by
  refine kernel_eq_zero_of_depth hrs hC hd J f hf (fun p => ?_) hJ
  have : IsNoetherian R (C p) := isNoetherian_of_isNoetherianRing_of_finite R (C p)
  have : Module.Finite R (cycles C d p) := Module.IsNoetherian.finite R _
  have : Module.Finite R (LinearMap.ker (f p)) := Module.IsNoetherian.finite R _
  obtain ⟨n, hn⟩ := exists_pow_smul_eq_zero_of_support_subset (hsupp p)
  exact ⟨n, fun x hx a ha => congrArg Subtype.val (hn a ha ⟨x, hx⟩)⟩

end KhanSL2.Depth

