module

public import KhanSL2.Depth.Collision
public import KhanSL2.Depth.MonicCoeffs
public import KhanSL2.Depth.FiniteMap
public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.RingTheory.Polynomial.IsIntegral
public import Mathlib.Algebra.Polynomial.Lifts
public import Mathlib.RingTheory.Support

@[expose] public section

/-!
# Depth of the weighted-root module, in coordinates

Let `B = r + 3s` with `s ≥ 1`. The pairs `(A, W)` of monic polynomials of degrees `r` and `s`
have coordinate ring `S = ℂ[a₀, …, a_{r-1}, w₀, …, w_{s-1}]` (the lower coefficients). The map
`ν : (A, W) ↦ A W³` makes `S` an `R_B`-algebra (`nu`); this is the paper's `ν_{r,s}`.

The main result is `depth_coord_ge`:
`depth_{P_B} S ≥ r + s - 1`. Its proof:

* **finiteness**: `A` and `W` divide a monic polynomial with coefficients from `R_B`, so their
  coefficients are integral over `R_B` (`finite_nu`);
* **the diagonal**: at a point where all of `P_B` vanishes, `A W³ = (u - a)^B`, hence
  `A = (u - a)^r` and `W = (u - a)^s` (`diagonal_of_collision`). The ideal `D` of the diagonal
  is generated by the `r + s - 1` graph coordinates over `w_{s-1} = -s a`, a regular sequence,
  and the Nullstellensatz gives `D ⊆ √(P_B S)` (`diag_le_radical`);
* **depth over `S`**: Rees' theorem with the regular sequence of `D` bounds
  `depth_{P_B S} S` (`le_depth_src`);
* **depth along `ν`**: `le_depth_of_le_depth_map` brings the bound down to `R_B`.
-/

noncomputable section

open MvPolynomial RingTheory.Sequence

namespace KhanSL2.Depth

/-- Coefficient coordinates on pairs `(A, W)` of monic polynomials of degrees `r, s`:
`X (inl k)` is the coefficient of `u^k` in `A`, `X (inr k)` that of `u^k` in `W`. -/
abbrev Src (r s : ℕ) : Type := MvPolynomial (Fin r ⊕ Fin s) ℂ

variable (r s : ℕ)

/-- The generic `A(u) = u^r + Σ_{k<r} a_k u^k`. -/
def genA : Polynomial (Src r s) := monicOf r fun k => X (Sum.inl k)

/-- The generic `W(u) = u^s + Σ_{k<s} w_k u^k`. -/
def genW : Polynomial (Src r s) := monicOf s fun k => X (Sum.inr k)

/-- `A W³`. -/
def genF : Polynomial (Src r s) := genA r s * genW r s ^ 3

theorem genA_monic : (genA r s).Monic := monicOf_monic _ _

theorem genW_monic : (genW r s).Monic := monicOf_monic _ _

theorem genF_monic : (genF r s).Monic := (genA_monic r s).mul ((genW_monic r s).pow 3)

theorem natDegree_genF : (genF r s).natDegree = r + 3 * s := by
  rw [genF, (genA_monic r s).natDegree_mul ((genW_monic r s).pow 3),
    (genW_monic r s).natDegree_pow, genA, genW, natDegree_monicOf, natDegree_monicOf]

/-- **The weighted-root map** `ν : R_B → S`,
`ν(e_{j+1}) = (-1)^{j+1} · [u^{B-(j+1)}] A W³`, i.e. `A W³ = Σ (-1)^i ν(e_i) u^{B-i}`. -/
def nu : RB (r + 3 * s) →ₐ[ℂ] Src r s :=
  aeval fun j => (-1) ^ ((j : ℕ) + 1) * (genF r s).coeff (r + 3 * s - ((j : ℕ) + 1))

theorem nu_X (j : Fin (r + 3 * s)) :
    nu r s (X j) = (-1) ^ ((j : ℕ) + 1) * (genF r s).coeff (r + 3 * s - ((j : ℕ) + 1)) := by
  rw [nu, aeval_X]

theorem nu_C (c : ℂ) : nu r s (C c) = C c := (nu r s).commutes c

/-! ## Points -/

variable {r s}

/-- `A W³` at a point. -/
def evalF (x : Fin r ⊕ Fin s → ℂ) : Polynomial ℂ := (genF r s).map (aeval x).toRingHom

theorem evalF_eq (x : Fin r ⊕ Fin s → ℂ) :
    evalF x = monicOf r (x ∘ Sum.inl) * monicOf s (x ∘ Sum.inr) ^ 3 := by
  rw [evalF, genF, Polynomial.map_mul, Polynomial.map_pow, genA, genW, map_monicOf, map_monicOf]
  have h1 : (⇑(aeval x).toRingHom ∘ fun k : Fin r => (X (Sum.inl k) : Src r s)) = x ∘ Sum.inl := by
    funext k; simp
  have h2 : (⇑(aeval x).toRingHom ∘ fun k : Fin s => (X (Sum.inr k) : Src r s)) = x ∘ Sum.inr := by
    funext k; simp
  rw [h1, h2]

theorem evalF_monic (x : Fin r ⊕ Fin s → ℂ) : (evalF x).Monic := (genF_monic r s).map _

theorem natDegree_evalF (x : Fin r ⊕ Fin s → ℂ) : (evalF x).natDegree = r + 3 * s := by
  rw [evalF, (genF_monic r s).natDegree_map, natDegree_genF]

theorem aeval_nu_X (x : Fin r ⊕ Fin s → ℂ) (j : Fin (r + 3 * s)) :
    aeval x (nu r s (X j)) =
      (-1) ^ ((j : ℕ) + 1) * (evalF x).coeff (r + 3 * s - ((j : ℕ) + 1)) := by
  rw [nu_X, map_mul, map_pow, map_neg, map_one, evalF, Polynomial.coeff_map]
  rfl

theorem aeval_nu_collisionGen (x : Fin r ⊕ Fin s → ℂ) (j : Fin (r + 3 * s)) :
    aeval x (nu r s (collisionGen (r + 3 * s) j)) =
      (-1) ^ ((j : ℕ) + 1) * (evalF x).coeff (r + 3 * s - ((j : ℕ) + 1)) -
        collisionCoeff (r + 3 * s) j *
          (-(evalF x).coeff (r + 3 * s - 1)) ^ ((j : ℕ) + 1) := by
  rw [collisionGen, map_sub, map_sub, map_mul, map_mul, map_pow, map_pow, aeval_nu_X, nu_C,
    aeval_C, aeval_nu_X]
  simp

/-- **At a point of full collision, `A = (u + b)^r` and `W = (u + b)^s`.** -/
theorem diagonal_of_collision (hs : 1 ≤ s) {x : Fin r ⊕ Fin s → ℂ}
    (hx : ∀ g ∈ collisionList (r + 3 * s), aeval x (nu r s g) = 0) :
    monicOf r (x ∘ Sum.inl) =
        (Polynomial.X + Polynomial.C ((evalF x).coeff (r + 3 * s - 1) / (r + 3 * s : ℕ))) ^ r ∧
      monicOf s (x ∘ Sum.inr) =
        (Polynomial.X + Polynomial.C ((evalF x).coeff (r + 3 * s - 1) / (r + 3 * s : ℕ))) ^ s := by
  set B := r + 3 * s with hBdef
  set b := (evalF x).coeff (B - 1) / (B : ℕ)
  have hB : 1 ≤ B := by omega
  have hF : evalF x = (Polynomial.X + Polynomial.C b) ^ B := by
    apply eq_X_add_C_pow_of_collision hB (evalF_monic x) (natDegree_evalF x)
    intro i hi2 hiB
    have hj : ((⟨i - 1, by omega⟩ : Fin B) : ℕ) ≠ 0 := by simp; omega
    have h1 := hx _ (collisionGen_mem B ⟨i - 1, by omega⟩ hj)
    rw [aeval_nu_collisionGen] at h1
    simp only [show i - 1 + 1 = i by omega] at h1
    have h2 : (-1 : ℂ) ^ i * (evalF x).coeff (B - i) =
        (-1) ^ i * (collisionCoeff B ⟨i - 1, by omega⟩ * (evalF x).coeff (B - 1) ^ i) := by
      rw [neg_pow' ((evalF x).coeff (B - 1)) i] at h1
      linear_combination h1
    have h3 := mul_left_cancel₀ (pow_ne_zero i (by norm_num : (-1 : ℂ) ≠ 0)) h2
    rw [h3, collisionCoeff, div_pow]
    simp only [show i - 1 + 1 = i by omega]
    ring
  have hAdvd : monicOf r (x ∘ Sum.inl) ∣ (Polynomial.X - Polynomial.C (-b)) ^ B := by
    rw [← X_add_C_eq_X_sub_C, ← hF, evalF_eq]
    exact dvd_mul_right _ _
  have hWdvd : monicOf s (x ∘ Sum.inr) ∣ (Polynomial.X - Polynomial.C (-b)) ^ B := by
    rw [← X_add_C_eq_X_sub_C, ← hF, evalF_eq]
    exact Dvd.dvd.mul_left (dvd_pow_self _ (by norm_num)) _
  constructor
  · rw [eq_X_sub_C_pow_of_dvd (monicOf_monic _ _) hAdvd, natDegree_monicOf, X_add_C_eq_X_sub_C]
  · rw [eq_X_sub_C_pow_of_dvd (monicOf_monic _ _) hWdvd, natDegree_monicOf, X_add_C_eq_X_sub_C]

/-! ## The diagonal -/

variable (r s)

/-- The parameter of the diagonal: the coefficient `w_{s-1}` of `W`. -/
def diagW (hs : 1 ≤ s) : Fin r ⊕ Fin s := Sum.inr ⟨s - 1, by omega⟩

/-- Coefficients of the graph of the diagonal over `w_{s-1}`. -/
def diagCoeff : Fin r ⊕ Fin s → ℂ
  | Sum.inl k => (r.choose k : ℂ) / (s : ℂ) ^ (r - k)
  | Sum.inr k => (s.choose k : ℂ) / (s : ℂ) ^ (s - k)

/-- Exponents of the graph of the diagonal over `w_{s-1}`. -/
def diagExp : Fin r ⊕ Fin s → ℕ
  | Sum.inl k => r - k
  | Sum.inr k => s - k

/-- The coordinates `a_0, …, a_{r-1}, w_0, …, w_{s-2}` graphed over `w_{s-1}`. -/
def diagVars : List (Fin r ⊕ Fin s) :=
  (List.finRange r).map Sum.inl ++
    (List.finRange (s - 1)).map fun k => Sum.inr (Fin.castLE (Nat.sub_le s 1) k)

/-- The `r + s - 1` generators of the ideal of the diagonal. -/
def diagList (hs : 1 ≤ s) : List (Src r s) :=
  (diagVars r s).map (graphCoord (diagW r s hs) (diagCoeff r s) (diagExp r s))

theorem diagList_length (hs : 1 ≤ s) : (diagList r s hs).length = r + s - 1 := by
  simp [diagList, diagVars]
  omega

theorem diagVars_nodup : (diagVars r s).Nodup := by
  rw [diagVars, List.nodup_append]
  refine ⟨(List.nodup_finRange r).map Sum.inl_injective,
    (List.nodup_finRange (s - 1)).map (fun a b h => Fin.castLE_injective _ (Sum.inr_injective h)),
    ?_⟩
  intro a ha b hb
  obtain ⟨_, _, rfl⟩ := List.mem_map.mp ha
  obtain ⟨_, _, rfl⟩ := List.mem_map.mp hb
  simp

theorem diagW_not_mem (hs : 1 ≤ s) : diagW r s hs ∉ diagVars r s := by
  rw [diagVars, List.mem_append, not_or]
  constructor
  · intro h
    obtain ⟨_, _, h⟩ := List.mem_map.mp h
    exact Sum.inl_ne_inr h
  · intro h
    obtain ⟨k, _, h⟩ := List.mem_map.mp h
    have := congrArg (fun v => match v with | Sum.inl _ => 0 | Sum.inr k => (k : ℕ)) h
    simp [diagW] at this
    omega

theorem diagList_isRegular (hs : 1 ≤ s) : IsRegular (Src r s) (diagList r s hs) :=
  graph_isRegular _ _ _ _ (diagVars_nodup r s) (diagW_not_mem r s hs)

variable {r s}

/-- The graph coordinates vanish on the diagonal. -/
theorem aeval_diagList_eq_zero (hs : 1 ≤ s) {x : Fin r ⊕ Fin s → ℂ} {b : ℂ}
    (hA : monicOf r (x ∘ Sum.inl) = (Polynomial.X + Polynomial.C b) ^ r)
    (hW : monicOf s (x ∘ Sum.inr) = (Polynomial.X + Polynomial.C b) ^ s)
    {g : Src r s} (hg : g ∈ diagList r s hs) : aeval x g = 0 := by
  have hxA (k : Fin r) : x (Sum.inl k) = b ^ (r - k) * (r.choose k : ℂ) := by
    have := congrArg (fun p => Polynomial.coeff p k) hA
    simpa [coeff_monicOf, Polynomial.coeff_X_add_C_pow] using this
  have hxW (k : Fin s) : x (Sum.inr k) = b ^ (s - k) * (s.choose k : ℂ) := by
    have := congrArg (fun p => Polynomial.coeff p k) hW
    simpa [coeff_monicOf, Polynomial.coeff_X_add_C_pow] using this
  have hxw : x (diagW r s hs) = b * s := by
    rw [diagW, hxW]
    simp only [show s - (s - 1) = 1 by omega, pow_one]
    rw [Nat.choose_symm (by omega), Nat.choose_one_right]
  have hsC : (s : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  obtain ⟨v, hv, rfl⟩ := List.mem_map.mp hg
  rw [graphCoord, graphTarget, map_sub, map_mul, map_pow, aeval_X, aeval_X, aeval_C, hxw]
  rw [diagVars, List.mem_append] at hv
  rcases hv with hv | hv
  · obtain ⟨k, _, rfl⟩ := List.mem_map.mp hv
    rw [hxA, diagCoeff, diagExp, Algebra.algebraMap_self_apply, mul_pow, div_mul_eq_mul_div]
    field_simp
    ring
  · obtain ⟨k, _, rfl⟩ := List.mem_map.mp hv
    rw [hxW, diagCoeff, diagExp, Algebra.algebraMap_self_apply, mul_pow, Fin.coe_castLE]
    field_simp
    ring

variable (r s)

/-- **The diagonal lies in the radical of `P_B S`** (Nullstellensatz). -/
theorem diag_le_radical (hs : 1 ≤ s) :
    Ideal.ofList (diagList r s hs) ≤
      (Ideal.map (nu r s) (collisionIdeal (r + 3 * s))).radical := by
  rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := ℂ), Ideal.ofList, Ideal.span_le]
  intro g hg
  rw [SetLike.mem_coe, MvPolynomial.mem_vanishingIdeal_iff]
  intro x hx
  rw [MvPolynomial.mem_zeroLocus_iff] at hx
  have hcol : ∀ g ∈ collisionList (r + 3 * s), aeval x (nu r s g) = 0 := fun g hg =>
    hx _ (Ideal.mem_map_of_mem _ (Ideal.subset_span hg))
  obtain ⟨hA, hW⟩ := diagonal_of_collision hs hcol
  exact aeval_diagList_eq_zero hs hA hW hg

/-- `P_B S` is a proper ideal: it vanishes at `A = u^r`, `W = u^s`. -/
theorem map_collisionIdeal_ne_top : Ideal.map (nu r s) (collisionIdeal (r + 3 * s)) ≠ ⊤ := by
  have hcomp : (aeval (0 : Fin r ⊕ Fin s → ℂ)).comp (nu r s) = aeval 0 := by
    apply MvPolynomial.algHom_ext
    intro j
    rw [AlgHom.comp_apply, aeval_nu_X, aeval_X, Pi.zero_apply, evalF_eq]
    simp only [show ((0 : Fin r ⊕ Fin s → ℂ) ∘ Sum.inl) = (0 : Fin r → ℂ) from rfl,
      show ((0 : Fin r ⊕ Fin s → ℂ) ∘ Sum.inr) = (0 : Fin s → ℂ) from rfl]
    have hm (n : ℕ) : monicOf n (0 : Fin n → ℂ) = Polynomial.X ^ n := by simp [monicOf]
    rw [hm, hm, ← pow_mul, ← pow_add, Polynomial.coeff_X_pow, if_neg (by omega), mul_zero]
  intro htop
  have h1 : (1 : Src r s) ∈ Ideal.map (nu r s) (collisionIdeal (r + 3 * s)) := by
    rw [htop]; exact Submodule.mem_top
  have hle : Ideal.map (nu r s) (collisionIdeal (r + 3 * s)) ≤
      RingHom.ker (aeval (0 : Fin r ⊕ Fin s → ℂ) : Src r s →ₐ[ℂ] ℂ) := by
    rw [Ideal.map_le_iff_le_comap, collisionIdeal, Ideal.ofList, Ideal.span_le]
    intro g hg
    obtain ⟨j, hj, rfl⟩ := mem_collisionList hg
    rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker]
    change ((aeval (0 : Fin r ⊕ Fin s → ℂ)).comp (nu r s)) (collisionGen _ j) = 0
    rw [hcomp, collisionGen, map_sub, map_mul, map_pow, aeval_X, aeval_X, aeval_C]
    simp
  have := hle h1
  rw [RingHom.mem_ker, map_one] at this
  exact one_ne_zero this

/-- **Depth over `S`**: `depth_{P_B S} S ≥ r + s - 1`. -/
theorem le_depth_src (hs : 1 ≤ s) :
    ((r + s - 1 : ℕ) : ℕ∞) ≤
      (Ideal.map (nu r s) (collisionIdeal (r + 3 * s))).depth (ModuleCat.of (Src r s) (Src r s)) := by
  set I := Ideal.map (nu r s) (collisionIdeal (r + 3 * s))
  set D := Ideal.ofList (diagList r s hs)
  have hreg := diagList_isRegular r s hs
  have hD : D • (⊤ : Submodule (Src r s) (Src r s)) < ⊤ :=
    lt_top_iff_ne_top.mpr hreg.top_ne_smul.symm
  have : Module.Finite (Src r s) (Shrink.{0} (Src r s ⧸ I)) :=
    Module.Finite.equiv (Shrink.linearEquiv (Src r s) (Src r s ⧸ I)).symm
  have hsupp : Module.support (Src r s) (Shrink.{0} (Src r s ⧸ I)) ⊆ PrimeSpectrum.zeroLocus D := by
    rw [(Shrink.linearEquiv (Src r s) (Src r s ⧸ I)).support_eq, Module.support_eq_zeroLocus,
      Ideal.annihilator_quotient]
    exact (PrimeSpectrum.zeroLocus_subset_zeroLocus_iff I D).mpr (diag_le_radical r s hs)
  have hext := ModuleCat.subsingleton_ext_of_exists_isRegular D
    (ModuleCat.of (Src r s) (Shrink.{0} (Src r s ⧸ I))) hsupp (ModuleCat.of (Src r s) (Src r s))
    hD (diagList r s hs) (fun g hg => Ideal.subset_span hg) hreg
  rw [Ideal.depth, ModuleCat.depth]
  apply le_sSup
  intro i hi
  apply hext i
  rw [diagList_length]
  exact_mod_cast hi

/-! ## Finiteness and the depth bound over `R_B` -/

/-- `S` is finite over `R_B` through `ν`. -/
theorem finite_nu [Algebra (RB (r + 3 * s)) (Src r s)]
    (h : algebraMap (RB (r + 3 * s)) (Src r s) = (nu r s : RB (r + 3 * s) →+* Src r s)) :
    Module.Finite (RB (r + 3 * s)) (Src r s) := by
  have hnu (y : RB (r + 3 * s)) : algebraMap (RB (r + 3 * s)) (Src r s) y = nu r s y := by rw [h]; rfl
  have hlifts : genF r s ∈ Polynomial.lifts (algebraMap (RB (r + 3 * s)) (Src r s)) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    rcases lt_or_ge n (r + 3 * s) with hn | hn
    · refine ⟨(-1) ^ (r + 3 * s - 1 - n + 1) * X ⟨r + 3 * s - 1 - n, by omega⟩, ?_⟩
      rw [hnu, map_mul, map_pow, map_neg, map_one, nu_X]
      simp only [show r + 3 * s - (r + 3 * s - 1 - n + 1) = n by omega]
      rw [← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul]
    · rcases hn.eq_or_lt with rfl | hn
      · refine ⟨1, ?_⟩
        rw [map_one]
        have := (genF_monic r s).leadingCoeff
        rw [Polynomial.leadingCoeff, natDegree_genF] at this
        exact this.symm
      · refine ⟨0, ?_⟩
        rw [map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [natDegree_genF]; exact hn)]
  obtain ⟨p, hp_map, -, hp_monic⟩ :=
    Polynomial.lifts_and_degree_eq_and_monic hlifts (genF_monic r s)
  have hA (k : ℕ) : IsIntegral (RB (r + 3 * s)) ((genA r s).coeff k) :=
    Polynomial.isIntegral_coeff_of_dvd p (genA r s) hp_monic (genA_monic r s)
      (by rw [hp_map, genF]; exact dvd_mul_right _ _) k
  have hW (k : ℕ) : IsIntegral (RB (r + 3 * s)) ((genW r s).coeff k) :=
    Polynomial.isIntegral_coeff_of_dvd p (genW r s) hp_monic (genW_monic r s)
      (by rw [hp_map, genF]; exact Dvd.dvd.mul_left (dvd_pow_self _ (by norm_num)) _) k
  have hX (v : Fin r ⊕ Fin s) : IsIntegral (RB (r + 3 * s)) (X v : Src r s) := by
    rcases v with k | k
    · have := hA k
      rwa [genA, coeff_monicOf] at this
    · have := hW k
      rwa [genW, coeff_monicOf] at this
  have hint : Algebra.IsIntegral (RB (r + 3 * s)) (Src r s) := ⟨fun f => by
    induction f using MvPolynomial.induction_on with
    | C a =>
      have : (C a : Src r s) = algebraMap (RB (r + 3 * s)) (Src r s) (C a) := by rw [hnu, nu_C]
      rw [this]
      exact isIntegral_algebraMap
    | add p q hp hq => exact hp.add hq
    | mul_X p v hp => exact hp.mul (hX v)⟩
  have : IsScalarTower ℂ (RB (r + 3 * s)) (Src r s) := IsScalarTower.of_algebraMap_eq fun c => by
    rw [hnu]
    exact ((nu r s).commutes c).symm
  have : Algebra.FiniteType (RB (r + 3 * s)) (Src r s) :=
    Algebra.FiniteType.of_restrictScalars_finiteType ℂ (RB (r + 3 * s)) (Src r s)
  exact Algebra.IsIntegral.finite

/-- **Depth of the weighted-root module, in coordinates**: for `s ≥ 1`,
`depth_{P_B} S ≥ r + s - 1`, where `S` is an `R_B`-algebra through `ν`. -/
theorem depth_coord_ge (hs : 1 ≤ s) [Algebra (RB (r + 3 * s)) (Src r s)]
    (h : algebraMap (RB (r + 3 * s)) (Src r s) = (nu r s : RB (r + 3 * s) →+* Src r s)) :
    ((r + s - 1 : ℕ) : ℕ∞) ≤
      (collisionIdeal (r + 3 * s)).depth (ModuleCat.of (RB (r + 3 * s)) (Src r s)) := by
  have := finite_nu r s h
  have hmap : (collisionIdeal (r + 3 * s)).map (algebraMap (RB (r + 3 * s)) (Src r s)) =
      (collisionIdeal (r + 3 * s)).map (nu r s) := by
    rw [h]
    rfl
  have hlt : collisionIdeal (r + 3 * s) • (⊤ : Submodule (RB (r + 3 * s)) (Src r s)) < ⊤ := by
    rw [Ideal.smul_top_eq_map, hmap, lt_top_iff_ne_top, Ne, Submodule.restrictScalars_eq_top_iff]
    exact map_collisionIdeal_ne_top r s
  have hn : ((r + s - 1 : ℕ) : ℕ∞) ≤ ((collisionIdeal (r + 3 * s)).map
      (algebraMap (RB (r + 3 * s)) (Src r s))).depth (ModuleCat.of (Src r s) (Src r s)) := by
    rw [hmap]
    exact le_depth_src r s hs
  exact le_depth_of_le_depth_map (collisionIdeal (r + 3 * s)) (Src r s) hlt _ hn

end KhanSL2.Depth
