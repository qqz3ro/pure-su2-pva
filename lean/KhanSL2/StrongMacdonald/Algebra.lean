module

public import KhanSL2.BGG.PositiveCE
public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.Algebra.MonoidAlgebra.Module

@[expose] public section

/-!
# The super-polynomial algebra of the Macdonald complex

Fishel–Grojnowski–Teleman's Koszul complex for `(𝔰𝔩₂[z], 𝔰𝔩₂)` with coefficients in
`S(𝔰𝔩₂[z]^*)` lives in the super-commutative algebra generated by even variables
`σ^a(-k)` (`k ≥ 0`) and odd variables `ψ^a(-k)` (`k ≥ 1`).

We realize it as polynomials in the even variables with coefficients in the existing
finite exterior algebra `BGG.PositiveCE.Cochain` on the odd variables. The odd mode
`⟨i, a⟩ : PositiveCE.Mode` stands for `ψ^a(-(i+1))`, exactly as in `PositiveCE`.
The even mode `⟨k, a⟩ : SMode` stands for `σ^a(-k)`.
-/

noncomputable section
open scoped BigOperators

namespace KhanSL2.StrongMacdonald

/-- Even generators `σ^a(-index)`. -/
@[ext] structure SMode where
  index : ℕ
  color : Fin 3
  deriving DecidableEq

/-- Odd generators `ψ^a(-(index+1))`. -/
abbrev PMode := BGG.PositiveCE.Mode

/-- The exterior algebra on the odd generators. -/
abbrev Ext := BGG.PositiveCE.Cochain

/-- Exponents of the even generators. -/
abbrev Exp := SMode →₀ ℕ

/-- The super-polynomial algebra: polynomials in `σ` with exterior coefficients in `ψ`. -/
abbrev W := AddMonoidAlgebra Ext Exp

open AddMonoidAlgebra

/-- A monomial `σ^e ψ_s`. -/
def mono (e : Exp) (s : Finset PMode) : W := single e (FiniteExterior.monomial s)

/-- The even generator `σ^a(-k)`. -/
def sig (g : SMode) : W := single (Finsupp.single g 1) 1

/-- The odd generator `ψ^a(-(i+1))`. -/
def psi (m : PMode) : W := single 0 (FiniteExterior.generator m)

/-- Exterior coefficients embedded in degree zero in the even variables. -/
def ofExt : Ext →ₐ[ℂ] W := AddMonoidAlgebra.singleZeroAlgHom

theorem ofExt_apply (u : Ext) : ofExt u = single 0 u := rfl

theorem psi_eq (m : PMode) : psi m = ofExt (FiniteExterior.generator m) := rfl

theorem one_eq_mono : (1 : W) = mono 0 ∅ := rfl

theorem single_mul_single' (e f : Exp) (u v : Ext) :
    (single e u : W) * single f v = single (e + f) (u * v) :=
  AddMonoidAlgebra.single_mul_single e f u v

theorem mono_mul_mono (e f : Exp) (s t : Finset PMode) :
    mono e s * mono f t =
      single (e + f) (FiniteExterior.monomialWedge BGG.PositiveCE.Mode.code s t) := by
  rw [mono, mono, single_mul_single', FiniteExterior.mul_def, FiniteExterior.wedge_monomial]
  rfl

theorem sig_mul_single (g : SMode) (e : Exp) (u : Ext) :
    sig g * single e u = single (Finsupp.single g 1 + e) u := by
  rw [sig, single_mul_single', one_mul]

theorem single_mul_sig (g : SMode) (e : Exp) (u : Ext) :
    single e u * sig g = single (e + Finsupp.single g 1) u := by
  rw [sig, single_mul_single', mul_one]

theorem psi_mul_single (m : PMode) (e : Exp) (u : Ext) :
    psi m * single e u = single e (FiniteExterior.generator m * u) := by
  rw [psi, single_mul_single', zero_add]

/-- Even generators are central. -/
theorem sig_commute (g : SMode) (x : W) : sig g * x = x * sig g := by
  induction x using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => rw [mul_add, add_mul, hx, hy]
  | single e u => rw [sig_mul_single, single_mul_sig, add_comm]

/-! ## Parity -/

/-- The parity automorphism, acting on exterior coefficients. -/
def parity : W →ₐ[ℂ] W := AddMonoidAlgebra.mapAlgHom Exp FiniteExterior.parity

@[simp] theorem parity_single (e : Exp) (u : Ext) :
    parity (single e u) = single e (FiniteExterior.parityLinear u) := by
  simp [parity, FiniteExterior.parity_apply]

@[simp] theorem parity_sig (g : SMode) : parity (sig g) = sig g := by
  simp [sig, FiniteExterior.one_def]

@[simp] theorem parity_psi (m : PMode) : parity (psi m) = -psi m := by
  simp [psi, AddMonoidAlgebra.single_neg]

theorem parity_parity (x : W) : parity (parity x) = x := by
  induction x using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy]
  | single e u => simp

/-! ## Induction over generators -/

theorem single_exp_add (e f : Exp) (u : Ext) :
    (single (e + f) u : W) = single e 1 * single f u := by
  rw [single_mul_single', one_mul]

/-- Every element is built from `1` by linear combinations and left multiplication by
generators. -/
theorem induction_gen {P : W → Prop} (hzero : P 0) (hone : P 1)
    (hadd : ∀ x y, P x → P y → P (x + y)) (hsmul : ∀ (r : ℂ) x, P x → P (r • x))
    (hsig : ∀ g x, P x → P (sig g * x)) (hpsi : ∀ m x, P x → P (psi m * x)) (x : W) :
    P x := by
  -- first the exterior coefficients in degree zero
  have hext : ∀ u : Ext, P (single 0 u) := by
    intro u
    refine FiniteExterior.induction_on BGG.PositiveCE.Mode.code (P := fun u => P (single 0 u)) ?_ ?_ ?_ ?_ ?_ u
    · simpa using hzero
    · exact hone
    · intro u v hu hv
      rw [AddMonoidAlgebra.single_add]
      exact hadd _ _ hu hv
    · intro r u hu
      rw [← AddMonoidAlgebra.smul_single]
      exact hsmul r _ hu
    · intro m u hu
      have : (single 0 (FiniteExterior.wedge BGG.PositiveCE.Mode.code (FiniteExterior.generator m) u) : W) =
          psi m * single 0 u := by
        rw [psi_mul_single, FiniteExterior.mul_def]
        rfl
      rw [this]
      exact hpsi m _ hu
  -- then the even exponent, by induction on the finsupp
  have hsingle : ∀ (e : Exp) (u : Ext), P (single e u) := by
    intro e
    induction e using Finsupp.induction with
    | zero => exact hext
    | single_add g n e hg hn ih =>
      intro u
      clear hg hn
      induction n with
      | zero => simpa using ih u
      | succ n ihn =>
        have hexp : Finsupp.single g (n + 1) + e = Finsupp.single g 1 + (Finsupp.single g n + e) := by
          rw [← add_assoc, ← Finsupp.single_add, add_comm 1 n]
        have h : (single (Finsupp.single g (n + 1) + e) u : W) =
            sig g * single (Finsupp.single g n + e) u := by
          rw [sig_mul_single, hexp]
        rw [h]
        exact hsig g _ ihn
  induction x using AddMonoidAlgebra.induction_linear with
  | zero => exact hzero
  | add x y hx hy => exact hadd _ _ hx hy
  | single e u => exact hsingle e u

end KhanSL2.StrongMacdonald
