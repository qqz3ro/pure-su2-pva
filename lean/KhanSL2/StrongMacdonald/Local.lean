module

public import KhanSL2.StrongMacdonald.OrderCalculus

@[expose] public section

/-!
# Locally finite sums of operators

The FGT operators are infinite sums over the loop degree `m`, but on any element only
finitely many summands are nonzero. `lsum P hP` is the sum of a family `P : ℕ → End W`
which is eventually zero on each element. Order bounds and derivation properties pass to
such sums. Eventual vanishing is checked on the subalgebras `Low N` generated by the modes
of index `< N`.
-/

noncomputable section
open scoped BigOperators

namespace KhanSL2.StrongMacdonald

/-! ## Elements generated by low modes -/

/-- Elements built from `1` using only generators of index `< N`. -/
inductive Low (N : ℕ) : W → Prop
  | zero : Low N 0
  | one : Low N 1
  | add {x y : W} : Low N x → Low N y → Low N (x + y)
  | smul (r : ℂ) {x : W} : Low N x → Low N (r • x)
  | sig {g : SMode} {x : W} : g.index < N → Low N x → Low N (sig g * x)
  | psi {m : PMode} {x : W} : m.index < N → Low N x → Low N (psi m * x)

theorem Low.mono {N M : ℕ} {x : W} (h : Low N x) (hNM : N ≤ M) : Low M x := by
  induction h with
  | zero => exact .zero
  | one => exact .one
  | add _ _ hx hy => exact hx.add hy
  | smul r _ hx => exact hx.smul r
  | sig hg _ hx => exact .sig (by omega) hx
  | psi hm _ hx => exact .psi (by omega) hx

theorem exists_low (x : W) : ∃ N, Low N x := by
  refine induction_gen (P := fun x => ∃ N, Low N x) ⟨0, .zero⟩ ⟨0, .one⟩ ?_ ?_ ?_ ?_ x
  · rintro x y ⟨N, hx⟩ ⟨M, hy⟩
    exact ⟨max N M, (hx.mono (le_max_left _ _)).add (hy.mono (le_max_right _ _))⟩
  · rintro r x ⟨N, hx⟩
    exact ⟨N, hx.smul r⟩
  · rintro g x ⟨N, hx⟩
    exact ⟨max N (g.index + 1), .sig (by omega) (hx.mono (le_max_left _ _))⟩
  · rintro m x ⟨N, hx⟩
    exact ⟨max N (m.index + 1), .psi (by omega) (hx.mono (le_max_left _ _))⟩

/-- A derivation killing the low generators kills the low subalgebra. -/
theorem IsDer.eq_zero_of_low {p N : ℕ} {D : Module.End ℂ W} (hD : IsDer p D)
    (hσ : ∀ g : SMode, g.index < N → D (sig g) = 0)
    (hψ : ∀ m : PMode, m.index < N → D (psi m) = 0) {x : W} (hx : Low N x) : D x = 0 := by
  induction hx with
  | zero => exact map_zero D
  | one => exact hD.map_one
  | add _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | smul r _ hx => rw [map_smul, hx, smul_zero]
  | sig hg _ hx => rw [hD, hσ _ hg, hx, zero_mul, mul_zero, add_zero]
  | psi hm _ hx => rw [hD, hψ _ hm, hx, zero_mul, mul_zero, add_zero]

/-! ## Eventually vanishing families -/

/-- On each element, all but finitely many members of the family vanish. -/
def EvZero (P : ℕ → Module.End ℂ W) : Prop := ∀ x, ∃ N, ∀ i, N ≤ i → P i x = 0

theorem EvZero.of_low {P : ℕ → Module.End ℂ W}
    (h : ∀ N i, N ≤ i → ∀ x, Low N x → P i x = 0) : EvZero P := by
  intro x
  obtain ⟨N, hx⟩ := exists_low x
  exact ⟨N, fun i hi => h N i hi x hx⟩

theorem EvZero.mul_right {P : ℕ → Module.End ℂ W} (hP : EvZero P) (A : Module.End ℂ W) :
    EvZero (fun i => P i * A) := fun x => hP (A x)

theorem EvZero.mul_left {P : ℕ → Module.End ℂ W} (hP : EvZero P) (A : Module.End ℂ W) :
    EvZero (fun i => A * P i) := by
  intro x
  obtain ⟨N, hN⟩ := hP x
  exact ⟨N, fun i hi => by rw [Module.End.mul_apply, hN i hi, map_zero]⟩

theorem EvZero.add {P Q : ℕ → Module.End ℂ W} (hP : EvZero P) (hQ : EvZero Q) :
    EvZero (fun i => P i + Q i) := by
  intro x
  obtain ⟨N, hN⟩ := hP x
  obtain ⟨M, hM⟩ := hQ x
  exact ⟨max N M, fun i hi => by
    rw [LinearMap.add_apply, hN i (le_of_max_le_left hi), hM i (le_of_max_le_right hi), add_zero]⟩

theorem EvZero.sub {P Q : ℕ → Module.End ℂ W} (hP : EvZero P) (hQ : EvZero Q) :
    EvZero (fun i => P i - Q i) := by
  intro x
  obtain ⟨N, hN⟩ := hP x
  obtain ⟨M, hM⟩ := hQ x
  exact ⟨max N M, fun i hi => by
    rw [LinearMap.sub_apply, hN i (le_of_max_le_left hi), hM i (le_of_max_le_right hi), sub_zero]⟩

theorem EvZero.smul {P : ℕ → Module.End ℂ W} (hP : EvZero P) (r : ℕ → ℂ) :
    EvZero (fun i => r i • P i) := by
  intro x
  obtain ⟨N, hN⟩ := hP x
  exact ⟨N, fun i hi => by rw [LinearMap.smul_apply, hN i hi, smul_zero]⟩

theorem EvZero.neg {P : ℕ → Module.End ℂ W} (hP : EvZero P) : EvZero (fun i => -P i) := by
  intro x
  obtain ⟨N, hN⟩ := hP x
  exact ⟨N, fun i hi => by rw [LinearMap.neg_apply, hN i hi, neg_zero]⟩

theorem EvZero.zero : EvZero (fun _ => 0) := fun _ => ⟨0, fun _ _ => rfl⟩

theorem EvZero.sum {ι : Type*} (s : Finset ι) {P : ι → ℕ → Module.End ℂ W}
    (hP : ∀ j ∈ s, EvZero (P j)) : EvZero (fun i => ∑ j ∈ s, P j i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using EvZero.zero
  | insert a s ha ih =>
    simp only [Finset.sum_insert ha]
    exact (hP a (Finset.mem_insert_self a s)).add (ih fun j hj => hP j (Finset.mem_insert_of_mem hj))

/-! ## The sum -/

theorem sum_range_eq_of_vanish {f : ℕ → W} {N M : ℕ} (hN : ∀ i, N ≤ i → f i = 0) (hNM : N ≤ M) :
    ∑ i ∈ Finset.range M, f i = ∑ i ∈ Finset.range N, f i := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hNM
  have h0 : ∑ x ∈ Finset.range k, f (N + x) = 0 :=
    Finset.sum_eq_zero fun i _ => hN _ (by omega)
  rw [Finset.sum_range_add, h0, add_zero]

/-- The underlying function of `lsum`. -/
def lsumFun (P : ℕ → Module.End ℂ W) (hP : EvZero P) (x : W) : W :=
  ∑ i ∈ Finset.range (Classical.choose (hP x)), P i x

theorem lsumFun_eq_of {P : ℕ → Module.End ℂ W} (hP : EvZero P) {x : W} {N : ℕ}
    (hN : ∀ i, N ≤ i → P i x = 0) : lsumFun P hP x = ∑ i ∈ Finset.range N, P i x := by
  have hx := Classical.choose_spec (hP x)
  unfold lsumFun
  rw [← sum_range_eq_of_vanish hx (le_max_left _ N),
    sum_range_eq_of_vanish hN (le_max_right _ _)]

/-- The sum of an eventually vanishing family of operators. -/
def lsum (P : ℕ → Module.End ℂ W) (hP : EvZero P) : Module.End ℂ W where
  toFun := lsumFun P hP
  map_add' x y := by
    obtain ⟨N1, h1⟩ := hP x
    obtain ⟨N2, h2⟩ := hP y
    obtain ⟨N3, h3⟩ := hP (x + y)
    have hN1 : ∀ i, max N1 (max N2 N3) ≤ i → P i x = 0 := fun i hi => h1 i (le_of_max_le_left hi)
    have hN2 : ∀ i, max N1 (max N2 N3) ≤ i → P i y = 0 :=
      fun i hi => h2 i (le_trans (le_max_left _ _) (le_of_max_le_right hi))
    have hN3 : ∀ i, max N1 (max N2 N3) ≤ i → P i (x + y) = 0 :=
      fun i hi => h3 i (le_trans (le_max_right _ _) (le_of_max_le_right hi))
    rw [lsumFun_eq_of hP hN1, lsumFun_eq_of hP hN2, lsumFun_eq_of hP hN3,
      ← Finset.sum_add_distrib]
    simp only [map_add]
  map_smul' r x := by
    obtain ⟨N1, h1⟩ := hP x
    obtain ⟨N2, h2⟩ := hP (r • x)
    have hN1 : ∀ i, max N1 N2 ≤ i → P i x = 0 := fun i hi => h1 i (le_of_max_le_left hi)
    have hN2 : ∀ i, max N1 N2 ≤ i → P i (r • x) = 0 := fun i hi => h2 i (le_of_max_le_right hi)
    rw [lsumFun_eq_of hP hN1, lsumFun_eq_of hP hN2, Finset.smul_sum]
    simp only [map_smul, RingHom.id_apply]

theorem lsum_apply_of {P : ℕ → Module.End ℂ W} (hP : EvZero P) {x : W} {N : ℕ}
    (hN : ∀ i, N ≤ i → P i x = 0) : lsum P hP x = ∑ i ∈ Finset.range N, P i x :=
  lsumFun_eq_of hP hN

theorem lsum_congr {P Q : ℕ → Module.End ℂ W} (hP : EvZero P) (hQ : EvZero Q)
    (h : ∀ i, P i = Q i) : lsum P hP = lsum Q hQ := by
  have : P = Q := funext h
  subst this
  rfl

theorem lsum_mul_right {P : ℕ → Module.End ℂ W} (hP : EvZero P) (A : Module.End ℂ W) :
    lsum P hP * A = lsum (fun i => P i * A) (hP.mul_right A) := by
  apply LinearMap.ext
  intro x
  obtain ⟨N, hN⟩ := hP (A x)
  rw [Module.End.mul_apply, lsum_apply_of hP hN,
    lsum_apply_of (hP.mul_right A) (N := N) (x := x) (fun i hi => hN i hi)]
  rfl

theorem lsum_mul_left {P : ℕ → Module.End ℂ W} (hP : EvZero P) (A : Module.End ℂ W) :
    A * lsum P hP = lsum (fun i => A * P i) (hP.mul_left A) := by
  apply LinearMap.ext
  intro x
  obtain ⟨N, hN⟩ := hP x
  rw [Module.End.mul_apply, lsum_apply_of hP hN,
    lsum_apply_of (hP.mul_left A) (N := N) (x := x)
      (fun i hi => by rw [Module.End.mul_apply, hN i hi, map_zero]),
    map_sum]
  rfl

theorem lsum_add {P Q : ℕ → Module.End ℂ W} (hP : EvZero P) (hQ : EvZero Q) :
    lsum P hP + lsum Q hQ = lsum (fun i => P i + Q i) (hP.add hQ) := by
  apply LinearMap.ext
  intro x
  obtain ⟨N, hN⟩ := hP x
  obtain ⟨M, hM⟩ := hQ x
  rw [LinearMap.add_apply, lsum_apply_of hP (N := max N M) (fun i hi => hN i (le_of_max_le_left hi)),
    lsum_apply_of hQ (N := max N M) (fun i hi => hM i (le_of_max_le_right hi)),
    lsum_apply_of (hP.add hQ) (N := max N M) (x := x) (fun i hi => by
      rw [LinearMap.add_apply, hN i (le_of_max_le_left hi), hM i (le_of_max_le_right hi),
        add_zero]),
    ← Finset.sum_add_distrib]
  rfl

theorem lsum_sub {P Q : ℕ → Module.End ℂ W} (hP : EvZero P) (hQ : EvZero Q) :
    lsum P hP - lsum Q hQ = lsum (fun i => P i - Q i) (hP.sub hQ) := by
  apply LinearMap.ext
  intro x
  obtain ⟨N, hN⟩ := hP x
  obtain ⟨M, hM⟩ := hQ x
  rw [LinearMap.sub_apply, lsum_apply_of hP (N := max N M) (fun i hi => hN i (le_of_max_le_left hi)),
    lsum_apply_of hQ (N := max N M) (fun i hi => hM i (le_of_max_le_right hi)),
    lsum_apply_of (hP.sub hQ) (N := max N M) (x := x) (fun i hi => by
      rw [LinearMap.sub_apply, hN i (le_of_max_le_left hi), hM i (le_of_max_le_right hi),
        sub_zero]),
    ← Finset.sum_sub_distrib]
  rfl

/-! ## Order and derivations pass to locally finite sums -/

theorem gcomm_lsum {P : ℕ → Module.End ℂ W} (hP : EvZero P) (p : ℕ) (g : Gen) :
    ∃ h : EvZero (fun i => gcomm p (P i) g), gcomm p (lsum P hP) g = lsum _ h := by
  have h : EvZero (fun i => gcomm p (P i) g) := by
    intro x
    obtain ⟨N, hN⟩ := hP (g.elt * x)
    obtain ⟨M, hM⟩ := hP x
    exact ⟨max N M, fun i hi => by
      rw [gcomm_apply, hN i (le_of_max_le_left hi), hM i (le_of_max_le_right hi)]
      simp⟩
  refine ⟨h, ?_⟩
  apply LinearMap.ext
  intro x
  obtain ⟨N, hN⟩ := hP (g.elt * x)
  obtain ⟨M, hM⟩ := hP x
  have hN' : ∀ i, max N M ≤ i → P i (g.elt * x) = 0 := fun i hi => hN i (le_of_max_le_left hi)
  have hM' : ∀ i, max N M ≤ i → P i x = 0 := fun i hi => hM i (le_of_max_le_right hi)
  rw [gcomm_apply, lsum_apply_of hP hN', lsum_apply_of hP hM',
    lsum_apply_of h (N := max N M) (fun i hi => by rw [gcomm_apply, hN' i hi, hM' i hi]; simp)]
  simp only [gcomm_apply, Finset.sum_sub_distrib, Finset.mul_sum, Finset.smul_sum]

theorem IsDiffOp.lsum {k p : ℕ} {P : ℕ → Module.End ℂ W} (hP : EvZero P)
    (h : ∀ i, IsDiffOp k p (P i)) : IsDiffOp k p (KhanSL2.StrongMacdonald.lsum P hP) := by
  induction k generalizing p P with
  | zero =>
    intro g
    obtain ⟨h', he⟩ := gcomm_lsum hP p g
    rw [he]
    apply LinearMap.ext
    intro x
    rw [lsum_apply_of h' (N := 0) (fun i _ => by rw [h i g]; rfl)]
    simp
  | succ k ih =>
    intro g
    obtain ⟨h', he⟩ := gcomm_lsum hP p g
    rw [he]
    exact ih h' fun i => h i g

theorem IsDer.lsum {p : ℕ} {P : ℕ → Module.End ℂ W} (hP : EvZero P)
    (h : ∀ i, IsDer p (P i)) : IsDer p (KhanSL2.StrongMacdonald.lsum P hP) := by
  intro x y
  obtain ⟨N1, h1⟩ := hP (x * y)
  obtain ⟨N2, h2⟩ := hP x
  obtain ⟨N3, h3⟩ := hP y
  set N := max N1 (max N2 N3)
  rw [lsum_apply_of hP (N := N) (fun i hi => h1 i (le_of_max_le_left hi)),
    lsum_apply_of hP (N := N) (fun i hi => h2 i (le_trans (le_max_left _ _) (le_of_max_le_right hi))),
    lsum_apply_of hP (N := N) (fun i hi => h3 i (le_trans (le_max_right _ _) (le_of_max_le_right hi))),
    Finset.sum_mul, Finset.mul_sum, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun i _ => h i x y

end KhanSL2.StrongMacdonald
