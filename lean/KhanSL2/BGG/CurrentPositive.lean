module

public import KhanSL2.BGG.CurrentCoordinates

@[expose] public section

/-! Positive currents are generated by their degree-one adjoint copy. -/

noncomputable section
open scoped TensorProduct

namespace KhanSL2.BGG

/-- Removing the constant part leaves a Lie combination of degree-one currents. -/
theorem sub_constant_mem (K : LieSubalgebra ℂ Current)
    (h1 : ∀ x : G, mode 1 x ∈ K) (u : Current) :
    u - constant (evalZero u) ∈ K := by
  induction u using TensorProduct.induction_on with
  | zero => simp
  | add u v hu hv =>
    simpa only [map_add, add_sub_add_comm] using K.add_mem hu hv
  | tmul p x =>
    induction p using Polynomial.induction_on' with
    | add p q hp hq =>
      simpa only [TensorProduct.add_tmul, map_add, add_sub_add_comm] using K.add_mem hp hq
    | monomial n a =>
      rw [monomial_tmul]
      cases n with
      | zero => simp
      | succ n =>
        simpa only [evalZero_positive_mode, map_zero, sub_zero] using
          positive_modes_mem K h1 n (a • x)

/-- The positive-current ideal is exactly the Lie algebra generated in degree one. -/
theorem lieSpan_mode_one_eq_positive :
    LieSubalgebra.lieSpan ℂ Current (Set.range (mode 1)) = positive.toLieSubalgebra := by
  apply le_antisymm
  · apply LieSubalgebra.lieSpan_le.mpr
    rintro u ⟨x, rfl⟩
    change evalZero (mode 1 x) = 0
    simp
  · intro u hu
    have h0 : evalZero u = 0 := hu
    have h := sub_constant_mem
      (LieSubalgebra.lieSpan ℂ Current (Set.range (mode 1)))
      (fun x => LieSubalgebra.subset_lieSpan (Set.mem_range_self x)) u
    simpa only [h0, map_zero, sub_zero] using h

/-- Every current has its specified constant part and a positive remainder. -/
theorem sub_constant_mem_positive (u : Current) : u - constant (evalZero u) ∈ positive := by
  change evalZero (u - constant (evalZero u)) = 0
  simp

/-- The constant and positive parts intersect only at zero. -/
theorem constant_mem_positive_iff (x : G) : constant x ∈ positive ↔ x = 0 := by
  change evalZero (constant x) = 0 ↔ x = 0
  simp

/-- The homogeneous positive-current copy indexed by its physical degree minus one. -/
def positiveMode (n : ℕ) : G →ₗ[ℂ] positive where
  toFun x := ⟨mode (n + 1) x, by
    change evalZero (mode (n + 1) x) = 0
    exact evalZero_positive_mode n x⟩
  map_add' x y := Subtype.ext ((mode (n + 1)).map_add x y)
  map_smul' a x := Subtype.ext ((mode (n + 1)).map_smul a x)

@[simp] theorem positiveMode_coe (n : ℕ) (x : G) :
    (positiveMode n x : Current) = mode (n + 1) x := rfl

theorem positiveMode_injective (n : ℕ) : Function.Injective (positiveMode n) := by
  intro x y h
  exact mode_injective (n + 1) (congrArg Subtype.val h)

/-- A Lie subalgebra of positive currents containing degree one is the whole algebra. -/
theorem positive_eq_top_of_degree_one (K : LieSubalgebra ℂ positive)
    (h : ∀ x : G, positiveMode 0 x ∈ K) : K = ⊤ := by
  apply eq_top_iff.mpr
  intro u _
  let K' := K.map positive.toLieSubalgebra.incl
  have hm : ∀ x : G, mode 1 x ∈ K' := by
    intro x
    exact ⟨positiveMode 0 x, h x, rfl⟩
  have hu : (u : Current) ∈ K' := by
    have hmem := sub_constant_mem K' hm (u : Current)
    have hzero : evalZero (u : Current) = 0 := u.property
    simpa only [hzero, map_zero, sub_zero] using hmem
  obtain ⟨v, hv, hvu⟩ := (LieSubalgebra.mem_map _ _ _).mp hu
  have heq : v = u := Subtype.ext hvu
  exact heq ▸ hv

theorem lieSpan_positiveMode_zero_eq_top :
    LieSubalgebra.lieSpan ℂ positive (Set.range (positiveMode 0)) = ⊤ := by
  apply positive_eq_top_of_degree_one
  intro x
  exact LieSubalgebra.subset_lieSpan (Set.mem_range_self x)
end KhanSL2.BGG