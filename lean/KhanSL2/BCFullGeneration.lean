module

public import KhanSL2.BCFullAlgebra

@[expose] public section

/-! Homogeneous CE fulls are generated by the finite exterior monomials. -/

noncomputable section

namespace KhanSL2

def fullModeDegree (m : FullMode) : Degree := (1, (m.bCount : ℤ), (m.weight : ℤ))

theorem fullMonomialDegree_insert (m : FullMode) (s : FullExteriorMonomial) (hm : m ∉ s) :
    fullMonomialDegree (insert m s) = fullModeDegree m + fullMonomialDegree s := by
  rw [Finset.insert_eq, fullMonomialDegree_union (by simpa using hm)]
  simp [fullMonomialDegree, fullModeDegree]

theorem full_homogeneous_induction {P : Degree → FullCochain → Prop}
    (hzero : ∀d, P d 0)
    (hone : P 0 fullOne)
    (hadd : ∀d u v, P d u → P d v → P d (u + v))
    (hsmul : ∀d (r : ℂ) u, P d u → P d (r • u))
    (hgen : ∀d m u, P d u → P (fullModeDegree m + d) (fullWedge (fullGenerator m) u))
    {d : Degree} {u : FullCochain} (hu : u ∈ fullPiece d) : P d u := by
  have hmono : ∀s : FullExteriorMonomial,
      P (fullMonomialDegree s) (Finsupp.single s 1) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      change P (0, 0, 0) (Finsupp.single ∅ 1) at hone
      simpa only [fullMonomialDegree, Finset.card_empty, Finset.sum_empty,
        Nat.cast_zero] using hone
    | @insert m s hm ih =>
      have h := hgen (fullMonomialDegree s) m (Finsupp.single s 1) ih
      have heq := FiniteExterior.monomial_insert FullMode.code m s hm
      change Finsupp.single (insert m s) 1 =
        _ • fullWedge (fullGenerator m) (Finsupp.single s 1) at heq
      rw [fullMonomialDegree_insert m s hm, heq]
      exact hsmul _ _ _ h
  rw [← u.sum_single, Finsupp.sum]
  apply Finset.sum_induction
  · intro a b ha hb
    exact hadd d a b ha hb
  · exact hzero d
  · intro s hs
    have hd : fullMonomialDegree s = d := hu hs
    have h := hsmul (fullMonomialDegree s) (u s) (Finsupp.single s 1) (hmono s)
    simpa only [hd, Finsupp.smul_single, smul_eq_mul, mul_one] using h

end KhanSL2
