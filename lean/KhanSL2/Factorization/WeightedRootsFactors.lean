module

public import KhanSL2.Factorization.WeightedRootsIdempotents

@[expose] public section

/-! The Boolean components are exactly the quotient rings defined by the two
weighted factor identities. These are coefficient identities, not assertions
only about geometric points. -/

noncomputable section
open scoped BigOperators
open Polynomial
namespace KhanSL2.Factorization.WeightedRoots

variable {A : Type*} [CommRing A]
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The ideal generated by every coefficient of a polynomial. -/
def coefficientIdeal (p : A[X]) : Ideal A := Ideal.span (Set.range p.coeff)

theorem coefficientIdeal_le_iff (p : A[X]) (I : Ideal A) :
    coefficientIdeal p ≤ I ↔ p.map (Ideal.Quotient.mk I) = 0 := by
  rw [coefficientIdeal,Ideal.span_le]
  constructor
  · intro h
    apply Polynomial.ext
    intro n
    simp only [coeff_map,coeff_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (h ⟨n,rfl⟩)
  · intro h a ha
    obtain ⟨n,rfl⟩ := ha
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have hn := congrArg (fun q : (A ⧸ I)[X] => q.coeff n) h
    simpa only [coeff_map,coeff_zero] using hn

/-- The ideal imposing the two specified weighted factor identities. -/
def factorIdeal (f₁ f₂ : A[X]) (x : ι → A) (m : ι → ℕ) (S : Finset ι) : Ideal A :=
  coefficientIdeal (rootProduct x m S - f₁) ⊔
    coefficientIdeal (rootProduct x m Sᶜ - f₂)

abbrev FactorRing (f₁ f₂ : A[X]) (x : ι → A) (m : ι → ℕ) (S : Finset ι) :=
  A ⧸ factorIdeal f₁ f₂ x m S

theorem factorIdeal_le_iff (f₁ f₂ : A[X]) (x : ι → A) (m : ι → ℕ)
    (S : Finset ι) (I : Ideal A) : factorIdeal f₁ f₂ x m S ≤ I ↔
      rootProduct (fun i => Ideal.Quotient.mk I (x i)) m S = f₁.map (Ideal.Quotient.mk I) ∧
      rootProduct (fun i => Ideal.Quotient.mk I (x i)) m Sᶜ = f₂.map (Ideal.Quotient.mk I) := by
  simp only [factorIdeal,sup_le_iff,coefficientIdeal_le_iff,Polynomial.map_sub,
    rootProduct_map,sub_eq_zero]

/-- The roots assigned to the first factor. -/
def selected (σ : ι → Bool) : Finset ι := Finset.univ.filter fun i => σ i

omit [DecidableEq ι] in
@[simp] theorem mem_selected (σ : ι → Bool) (i : ι) : i ∈ selected σ ↔ σ i = true := by
  simp [selected]

@[simp] theorem mem_selected_compl (σ : ι → Bool) (i : ι) : i ∈ (selected σ)ᶜ ↔ σ i = false := by
  simp [selected]

theorem rootProduct_partition (x : ι → A) (m : ι → ℕ) (S : Finset ι) :
    rootProduct x m S * rootProduct x m Sᶜ = rootProduct x m Finset.univ := by
  rw [← rootProduct_union x m disjoint_compl_right,Finset.union_compl]

/-- Selectors obtained from an actual weighted factorization. -/
def rootSelectors (β f₂ : A[X]) (x : ι → A) : ι → A := fun i => selector β f₂ (x i)

omit [DecidableEq ι] in
theorem rootSelectors_idempotent {α β f₁ f₂ : A[X]}
    (hbez : α*f₁ + β*f₂ = 1) (x : ι → A) (m : ι → ℕ) (hm : ∀ i, 0 < m i)
    (hprod : rootProduct x m Finset.univ = f₁*f₂) :
    ∀ i, IsIdempotentElem (rootSelectors β f₂ x i) := by
  intro i
  apply selector_isIdempotent hbez
  rw [← hprod]
  exact rootProduct_eval_eq_zero x m Finset.univ (Finset.mem_univ i) (hm i)

theorem factorIdeal_le_componentIdeal {α β f₁ f₂ : A[X]}
    (hf₁ : f₁.Monic) (hf₂ : f₂.Monic) (hbez : α*f₁ + β*f₂ = 1)
    (x : ι → A) (m : ι → ℕ) (hm : ∀ i, 0 < m i)
    (hprod : rootProduct x m Finset.univ = f₁*f₂) (σ : ι → Bool) :
    factorIdeal f₁ f₂ x m (selected σ) ≤ componentIdeal (rootSelectors β f₂ x) σ := by
  let I := componentIdeal (rootSelectors β f₂ x) σ
  let q := Ideal.Quotient.mk I
  have he := rootSelectors_idempotent hbez x m hm hprod
  have hsel (i : ι) : selector (β.map q) (f₂.map q) (q (x i)) = if σ i then 1 else 0 := by
    rw [selector_map]
    exact selector_in_component (rootSelectors β f₂ x) he σ i
  have hb : α.map q * f₁.map q + β.map q * f₂.map q = 1 := by
    simpa only [Polynomial.map_add,Polynomial.map_mul,Polynomial.map_one] using
      congrArg (Polynomial.map q) hbez
  apply (factorIdeal_le_iff f₁ f₂ x m (selected σ) I).mpr
  apply factors_eq_of_assignment (hf₁.map q) (hf₂.map q) (fun i => q (x i)) m
  · rw [rootProduct_partition,← rootProduct_map,hprod,Polynomial.map_mul]
  · intro i hi
    apply isUnit_eval_right_of_selector_one
    simpa only [(mem_selected σ i).mp hi,if_true] using hsel i
  · intro i hi
    apply isUnit_eval_left_of_selector_zero hb
    simpa only [(mem_selected_compl σ i).mp hi,Bool.false_eq_true,if_false] using hsel i

theorem componentIdeal_le_factorIdeal {α β f₁ f₂ : A[X]}
    (hbez : α*f₁ + β*f₂ = 1) (x : ι → A) (m : ι → ℕ) (hm : ∀ i, 0 < m i)
    (σ : ι → Bool) :
    componentIdeal (rootSelectors β f₂ x) σ ≤ factorIdeal f₁ f₂ x m (selected σ) := by
  let I := factorIdeal f₁ f₂ x m (selected σ)
  let q := Ideal.Quotient.mk I
  have hf := (factorIdeal_le_iff f₁ f₂ x m (selected σ) I).mp le_rfl
  have hb : α.map q * f₁.map q + β.map q * f₂.map q = 1 := by
    simpa only [Polynomial.map_add,Polynomial.map_mul,Polynomial.map_one] using
      congrArg (Polynomial.map q) hbez
  have hs (i : ι) : q (rootSelectors β f₂ x i) = if σ i then 1 else 0 := by
    change q (selector β f₂ (x i)) = _
    rw [← selector_map]
    cases hσ : σ i
    · simp only [hσ,Bool.false_eq_true,if_false]
      have hi : i ∈ (selected σ)ᶜ := (mem_selected_compl σ i).mpr hσ
      have hr : (f₂.map q).eval (q (x i)) = 0 := by
        rw [← hf.2]
        exact rootProduct_eval_eq_zero (fun j => q (x j)) m _ hi (hm i)
      simp only [selector,hr,mul_zero]
    · simp only [hσ,if_true]
      have hi : i ∈ selected σ := (mem_selected σ i).mpr hσ
      have hr : (f₁.map q).eval (q (x i)) = 0 := by
        rw [← hf.1]
        exact rootProduct_eval_eq_zero (fun j => q (x j)) m _ hi (hm i)
      have he := congrArg (fun p => p.eval (q (x i))) hb
      simpa only [eval_add,eval_mul,eval_one,hr,mul_zero,zero_add,selector] using he
  apply Ideal.span_le.mpr
  intro a ha
  rcases Set.mem_singleton_iff.mp ha with rfl
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q (1-assignment (rootSelectors β f₂ x) σ) = 0
  rw [map_sub,map_one]
  suffices q (assignment (rootSelectors β f₂ x) σ) = 1 by rw [this,sub_self]
  unfold assignment
  rw [map_prod]
  apply Finset.prod_eq_one
  intro i _
  unfold choice
  cases hσ : σ i <;> simp only [hσ,Bool.false_eq_true,if_false,if_true,map_sub,map_one,
    hs i,hσ,if_true,if_false,sub_zero]

theorem componentIdeal_eq_factorIdeal {α β f₁ f₂ : A[X]}
    (hf₁ : f₁.Monic) (hf₂ : f₂.Monic) (hbez : α*f₁ + β*f₂ = 1)
    (x : ι → A) (m : ι → ℕ) (hm : ∀ i, 0 < m i)
    (hprod : rootProduct x m Finset.univ = f₁*f₂) (σ : ι → Bool) :
    componentIdeal (rootSelectors β f₂ x) σ = factorIdeal f₁ f₂ x m (selected σ) :=
  le_antisymm (componentIdeal_le_factorIdeal hbez x m hm σ)
    (factorIdeal_le_componentIdeal hf₁ hf₂ hbez x m hm hprod σ)

/-- Coprime weighted-root splitting, with the original factor coefficient ideals.
The product includes all assignments; assignments of the wrong total weight
are zero rings and may subsequently be discarded. -/
def splittingEquiv {α β f₁ f₂ : A[X]}
    (hf₁ : f₁.Monic) (hf₂ : f₂.Monic) (hbez : α*f₁ + β*f₂ = 1)
    (x : ι → A) (m : ι → ℕ) (hm : ∀ i, 0 < m i)
    (hprod : rootProduct x m Finset.univ = f₁*f₂) :
    A ≃+* ∀ σ : ι → Bool, FactorRing f₁ f₂ x m (selected σ) :=
  (assignmentEquiv (rootSelectors β f₂ x) (rootSelectors_idempotent hbez x m hm hprod)).trans
    (RingEquiv.piCongrRight fun σ => Ideal.quotEquivOfEq
      (componentIdeal_eq_factorIdeal hf₁ hf₂ hbez x m hm hprod σ))

@[simp] theorem splittingEquiv_apply {α β f₁ f₂ : A[X]}
    (hf₁ : f₁.Monic) (hf₂ : f₂.Monic) (hbez : α*f₁ + β*f₂ = 1)
    (x : ι → A) (m : ι → ℕ) (hm : ∀ i, 0 < m i)
    (hprod : rootProduct x m Finset.univ = f₁*f₂) (a : A) (σ : ι → Bool) :
    splittingEquiv hf₁ hf₂ hbez x m hm hprod a σ = Ideal.Quotient.mk _ a := by
  simp only [splittingEquiv,RingEquiv.trans_apply,RingEquiv.piCongrRight_apply,
    assignmentEquiv_apply,Ideal.quotEquivOfEq_mk]

end KhanSL2.Factorization.WeightedRoots


