module

public import Mathlib.Algebra.FreeAlgebra
public import KhanSL2.Basic

@[expose] public section

/-!
# The presented source differential superalgebra

This is a concrete generators-and-relations construction.  Before imposing the
four displayed differential relations, the presentation is the polynomial
algebra on the even `X i` tensor the exterior algebra on the odd `Y i`.
Translation shifts each index and is extended by the ordinary Leibniz rule.

The inductively generated relation below is the *least* algebra congruence
containing the listed equations and closed under translation.  Thus its closure
under translation imposes precisely the differential ideal generated by the
four equations, and does not assume any identity in the target cohomology.
-/

namespace KhanSL2

namespace SourcePresentation

inductive Generator
  | X : ℕ → Generator
  | Y : ℕ → Generator
  deriving DecidableEq

abbrev Expression := FreeAlgebra.Pre ℂ Generator

attribute [local instance] FreeAlgebra.Pre.hasCoeGenerator
  FreeAlgebra.Pre.hasCoeSemiring FreeAlgebra.Pre.hasMul
  FreeAlgebra.Pre.hasAdd FreeAlgebra.Pre.hasZero FreeAlgebra.Pre.hasOne
  FreeAlgebra.Pre.hasSMul

def x (i : ℕ) : Expression := .of (.X i)
def y (i : ℕ) : Expression := .of (.Y i)

/-- The even translation derivation on finite expressions. -/
def translate : Expression → Expression
  | .of (.X i) => x (i + 1)
  | .of (.Y i) => y (i + 1)
  | .ofScalar _ => 0
  | .add a b => translate a + translate b
  | .mul a b => translate a * b + a * translate b

/-- The exact differential algebra presentation; all closure rules are explicit. -/
inductive Relation : Expression → Expression → Prop
  | algebra {a b} : FreeAlgebra.Rel ℂ Generator a b → Relation a b
  | xx (i j) : Relation (x i * x j) (x j * x i)
  | xy (i j) : Relation (x i * y j) (y j * x i)
  | yy (i j) : Relation (y i * y j) ((-1 : ℂ) • (y j * y i))
  | yy_self (i) : Relation (y i * y i) 0
  | x0_sq : Relation (x 0 * x 0) 0
  | x0_y0 : Relation (x 0 * y 0) 0
  | x0_y1 : Relation (x 0 * y 1) 0
  | y0_y1 : Relation (y 0 * y 1) 0
  | translate {a b} : Relation a b → Relation (translate a) (translate b)
  | add_left {a b c} : Relation a b → Relation (a + c) (b + c)
  | add_right {a b c} : Relation a b → Relation (c + a) (c + b)
  | mul_left {a b c} : Relation a b → Relation (a * c) (b * c)
  | mul_right {a b c} : Relation a b → Relation (c * a) (c * b)

/-- Homogeneous expressions for the grading (CE degree, `y`-count, spin). -/
inductive Homogeneous : Degree → Expression → Prop
  | zero (d) : Homogeneous d 0
  | scalar (r : ℂ) : Homogeneous 0 (.ofScalar r)
  | x (i : ℕ) : Homogeneous (2, 1, (i : ℤ) + 2) (x i)
  | y (i : ℕ) : Homogeneous (3, 3, (i : ℤ) + 3) (y i)
  | add {d a b} : Homogeneous d a → Homogeneous d b → Homogeneous d (a + b)
  | mul {d e a b} :
      Homogeneous d a → Homogeneous e b → Homogeneous (d + e) (a * b)

theorem Homogeneous.translate {d : Degree} {a : Expression}
    (h : Homogeneous d a) : Homogeneous (d + (0, 0, 1)) (translate a) := by
  induction h with
  | zero d => exact Homogeneous.zero _
  | scalar _ => exact Homogeneous.zero _
  | x i => simpa [SourcePresentation.translate, SourcePresentation.x, Nat.cast_add, Nat.cast_one,
      add_assoc] using Homogeneous.x (i + 1)
  | y i => simpa [SourcePresentation.translate, SourcePresentation.y, Nat.cast_add, Nat.cast_one,
      add_assoc] using Homogeneous.y (i + 1)
  | add _ _ ia ib => exact Homogeneous.add ia ib
  | @mul d e a b ha hb ia ib =>
    apply Homogeneous.add
    · simpa [add_assoc, add_left_comm, add_comm] using Homogeneous.mul ia hb
    · simpa [add_assoc] using Homogeneous.mul ha ib

end SourcePresentation

/-- The source algebra, constructed as a quotient of finite expressions. -/
def Source := Quot SourcePresentation.Relation

namespace Source

open SourcePresentation

attribute [local instance] FreeAlgebra.Pre.hasCoeGenerator
  FreeAlgebra.Pre.hasCoeSemiring FreeAlgebra.Pre.hasMul
  FreeAlgebra.Pre.hasAdd FreeAlgebra.Pre.hasZero FreeAlgebra.Pre.hasOne
  FreeAlgebra.Pre.hasSMul

def mk (a : Expression) : Source := Quot.mk Relation a

instance : SMul ℂ Source where
  smul r := Quot.map (fun a : Expression => (.ofScalar r) * a)
    (fun _ _ => Relation.mul_right)

instance : Zero Source := ⟨mk 0⟩
instance : One Source := ⟨mk 1⟩
instance : Add Source where
  add := Quot.map₂ (· + ·) (fun _ _ _ => Relation.add_right)
    (fun _ _ _ => Relation.add_left)
instance : Mul Source where
  mul := Quot.map₂ (· * ·) (fun _ _ _ => Relation.mul_right)
    (fun _ _ _ => Relation.mul_left)

@[simp] theorem mk_zero : mk 0 = (0 : Source) := rfl
@[simp] theorem mk_one : mk 1 = (1 : Source) := rfl
@[simp] theorem mk_add (a b : Expression) : mk (a + b) = mk a + mk b := rfl
@[simp] theorem mk_mul (a b : Expression) : mk (a * b) = mk a * mk b := rfl
@[simp] theorem mk_smul (r : ℂ) (a : Expression) : mk (r • a) = r • mk a := rfl

instance instMonoidWithZero : MonoidWithZero Source where
  mul_assoc := by
    rintro ⟨a⟩ ⟨b⟩ ⟨c⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.mul_assoc)
  one_mul := by
    rintro ⟨a⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.one_mul)
  mul_one := by
    rintro ⟨a⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.mul_one)
  zero_mul := by
    rintro ⟨a⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.zero_mul)
  mul_zero := by
    rintro ⟨a⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.mul_zero)

instance instDistrib : Distrib Source where
  left_distrib := by
    rintro ⟨a⟩ ⟨b⟩ ⟨c⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.left_distrib)
  right_distrib := by
    rintro ⟨a⟩ ⟨b⟩ ⟨c⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.right_distrib)

instance instAddCommMonoid : AddCommMonoid Source where
  add_assoc := by
    rintro ⟨a⟩ ⟨b⟩ ⟨c⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.add_assoc)
  zero_add := by
    rintro ⟨a⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.zero_add)
  add_zero := by
    rintro ⟨a⟩
    exact (Quot.sound (Relation.algebra FreeAlgebra.Rel.add_comm)).trans
      (Quot.sound (Relation.algebra FreeAlgebra.Rel.zero_add))
  add_comm := by
    rintro ⟨a⟩ ⟨b⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.add_comm)
  nsmul n a := (n : ℂ) • a
  nsmul_zero := by
    rintro ⟨a⟩
    change mk ((.ofScalar ((0 : ℕ) : ℂ)) * a) = mk 0
    rw [Nat.cast_zero]
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.zero_mul)
  nsmul_succ n := by
    rintro ⟨a⟩
    change mk ((.ofScalar ((n + 1 : ℕ) : ℂ)) * a) =
      mk ((.ofScalar (n : ℂ)) * a) + mk a
    rw [Nat.cast_add, Nat.cast_one]
    have h := Quot.sound (Relation.algebra
      (FreeAlgebra.Rel.mul_compat_left (c := a)
        (FreeAlgebra.Rel.add_scalar (r := (n : ℂ)) (s := 1))))
    change mk ((.ofScalar ((n : ℂ) + 1)) * a) =
      mk (((.ofScalar (n : ℂ)) + (.ofScalar 1)) * a) at h
    rw [h, mk_mul, mk_add, right_distrib, mk_mul]
    change mk (.ofScalar (n : ℂ)) * mk a + 1 * mk a =
      mk (.ofScalar (n : ℂ)) * mk a + mk a
    rw [one_mul]

instance : Semiring Source where
  __ := instMonoidWithZero
  __ := instDistrib
  __ := instAddCommMonoid
  natCast n := mk (.ofScalar (n : ℂ))
  natCast_zero := by change mk (.ofScalar ((0 : ℕ) : ℂ)) = mk 0; rw [Nat.cast_zero]; rfl
  natCast_succ n := by
    change mk (.ofScalar ((n + 1 : ℕ) : ℂ)) =
      mk ((.ofScalar (n : ℂ)) + (.ofScalar 1))
    rw [Nat.cast_add, Nat.cast_one]
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.add_scalar)

instance : Algebra ℂ Source where
  algebraMap := {
    toFun := fun r => mk (.ofScalar r)
    map_one' := rfl
    map_mul' := fun _ _ => Quot.sound (Relation.algebra FreeAlgebra.Rel.mul_scalar)
    map_zero' := rfl
    map_add' := fun _ _ => Quot.sound (Relation.algebra FreeAlgebra.Rel.add_scalar) }
  commutes' r := by
    rintro ⟨a⟩
    exact Quot.sound (Relation.algebra FreeAlgebra.Rel.central_scalar)
  smul_def' _ _ := rfl

instance : Ring Source := Algebra.semiringToRing ℂ

def X (i : ℕ) : Source := mk (x i)
def Y (i : ℕ) : Source := mk (y i)

/-- Translation descends because the defining relation is differentially closed. -/
def translate : Source → Source :=
  Quot.map SourcePresentation.translate (fun _ _ => Relation.translate)

@[simp] theorem translate_mk (a : Expression) :
    translate (mk a) = mk (SourcePresentation.translate a) := rfl

@[simp] theorem translate_X (i : ℕ) : translate (X i) = X (i + 1) := rfl
@[simp] theorem translate_Y (i : ℕ) : translate (Y i) = Y (i + 1) := rfl
@[simp] theorem translate_zero : translate 0 = 0 := rfl
@[simp] theorem translate_one : translate 1 = 0 := rfl

theorem translate_add (a b : Source) :
    translate (a + b) = translate a + translate b := by
  induction a using Quot.inductionOn
  induction b using Quot.inductionOn
  rfl

theorem translate_mul (a b : Source) :
    translate (a * b) = translate a * b + a * translate b := by
  induction a using Quot.inductionOn
  induction b using Quot.inductionOn
  rfl

theorem translate_smul (r : ℂ) (a : Source) :
    translate (r • a) = r • translate a := by
  induction a using Quot.inductionOn with
  | _ a =>
    change mk (0 * a + (.ofScalar r) * SourcePresentation.translate a) =
      mk ((.ofScalar r) * SourcePresentation.translate a)
    rw [mk_add, mk_mul, mk_zero, zero_mul, zero_add]

/-- The translation operator as a complex linear map. -/
def translation : Source →ₗ[ℂ] Source where
  toFun := translate
  map_add' := translate_add
  map_smul' := translate_smul

@[simp] theorem translation_X (i : ℕ) : translation (X i) = X (i + 1) := rfl
@[simp] theorem translation_Y (i : ℕ) : translation (Y i) = Y (i + 1) := rfl
theorem translation_mul (a b : Source) :
    translation (a * b) = translation a * b + a * translation b :=
  translate_mul a b

theorem X_mul_X (i j : ℕ) : X i * X j = X j * X i :=
  Quot.sound (Relation.xx i j)
theorem X_mul_Y (i j : ℕ) : X i * Y j = Y j * X i :=
  Quot.sound (Relation.xy i j)
theorem Y_mul_Y (i j : ℕ) : Y i * Y j = -(Y j * Y i) := by
  change mk (y i * y j) = -(mk (y j * y i))
  have h : mk (y i * y j) = mk ((-1 : ℂ) • (y j * y i)) :=
    Quot.sound (Relation.yy i j)
  rw [h, mk_smul, neg_one_smul]
@[simp] theorem Y_mul_self (i : ℕ) : Y i * Y i = 0 :=
  Quot.sound (Relation.yy_self i)

@[simp] theorem X0_sq : X 0 * X 0 = 0 := Quot.sound Relation.x0_sq
@[simp] theorem X0_Y0 : X 0 * Y 0 = 0 := Quot.sound Relation.x0_y0
@[simp] theorem X0_Y1 : X 0 * Y 1 = 0 := Quot.sound Relation.x0_y1
@[simp] theorem Y0_Y1 : Y 0 * Y 1 = 0 := Quot.sound Relation.y0_y1

/-- The homogeneous component, expressed as classes of homogeneous expressions. -/
def piece (d : Degree) : Submodule ℂ Source where
  carrier := { a | ∃ e : Expression, SourcePresentation.Homogeneous d e ∧ mk e = a }
  zero_mem' := ⟨0, .zero d, rfl⟩
  add_mem' := by
    rintro a b ⟨e, he, rfl⟩ ⟨f, hf, rfl⟩
    exact ⟨e + f, .add he hf, rfl⟩
  smul_mem' := by
    rintro r a ⟨e, he, rfl⟩
    refine ⟨r • e, ?_, rfl⟩
    change SourcePresentation.Homogeneous d (.ofScalar r * e)
    simpa using SourcePresentation.Homogeneous.mul (.scalar r) he

theorem X_mem (i : ℕ) : X i ∈ piece (2, 1, (i : ℤ) + 2) :=
  ⟨x i, .x i, rfl⟩

theorem Y_mem (i : ℕ) : Y i ∈ piece (3, 3, (i : ℤ) + 3) :=
  ⟨y i, .y i, rfl⟩

theorem one_mem : (1 : Source) ∈ piece 0 :=
  ⟨1, .scalar 1, rfl⟩

theorem mul_mem {d e : Degree} {a b : Source} (ha : a ∈ piece d) (hb : b ∈ piece e) :
    a * b ∈ piece (d + e) := by
  obtain ⟨a, ha, rfl⟩ := ha
  obtain ⟨b, hb, rfl⟩ := hb
  exact ⟨a * b, .mul ha hb, rfl⟩

theorem translation_mem {d : Degree} {a : Source} (ha : a ∈ piece d) :
    translation a ∈ piece (d + (0, 0, 1)) := by
  obtain ⟨a, ha, rfl⟩ := ha
  exact ⟨SourcePresentation.translate a, ha.translate, rfl⟩

/-- Every element has a finite algebra expression in the displayed generators. -/
@[elab_as_elim] theorem inductionOn (a : Source) {P : Source → Prop}
    (scalar : ∀ r : ℂ, P (algebraMap ℂ Source r))
    (hx : ∀ i, P (X i)) (hy : ∀ i, P (Y i))
    (add : ∀ a b, P a → P b → P (a + b))
    (mul : ∀ a b, P a → P b → P (a * b)) : P a := by
  induction a using Quot.inductionOn with
  | _ a =>
    induction a with
    | of g =>
      cases g with
      | X i => exact hx i
      | Y i => exact hy i
    | ofScalar r => exact scalar r
    | add a b ha hb => exact add (mk a) (mk b) ha hb
    | mul a b ha hb => exact mul (mk a) (mk b) ha hb

theorem algHom_ext {A : Type*} [Semiring A] [Algebra ℂ A]
    (f g : Source →ₐ[ℂ] A)
    (hx : ∀ i, f (X i) = g (X i))
    (hy : ∀ i, f (Y i) = g (Y i)) : f = g := by
  ext a
  induction a using inductionOn with
  | scalar r => rw [f.commutes, g.commutes]
  | hx i => exact hx i
  | hy i => exact hy i
  | add a b ha hb => simp only [map_add, ha, hb]
  | mul a b ha hb => simp only [map_mul, ha, hb]

end Source
end KhanSL2
