module

public import KhanSL2.BGGBridge.BaseChange
public import KhanSL2.BGG.FreeCEEquivarianceAction
public import KhanSL2.BGG.UEGeneration

@[expose] public section

/-!
# The right action of `U(𝔩₊)` on a current-algebra module

A module `N` over `𝔩 = 𝔰𝔩₂[z]` is a right module over `U(𝔩₊)` through the antipode:
`n · y = -y·n` for `y ∈ 𝔩₊`. This is the right action used to form `N ⊗_{U(𝔩₊)} (U(𝔩₊) ⊗ Λ)`.

The right action is compatible with the constant `𝔰𝔩₂`: the commutator of `t ∈ 𝔰𝔩₂` with
`n ↦ n·u` is `n ↦ n·(t·u)`, where `t` acts on `U(𝔩₊)` by the extended adjoint derivation.
-/

noncomputable section

open MulOpposite

namespace KhanSL2.BGGBridge

open KhanSL2.BGG

attribute [local instance 100] LieRing.ofAssociativeRing

/-- Induction over the positive enveloping algebra: it is generated by the positive currents. -/
theorem positiveUE_induction {P : PositiveEnveloping → Prop}
    (hι : ∀ y : positive, P (UniversalEnvelopingAlgebra.ι ℂ y))
    (halg : ∀ r : ℂ, P (algebraMap ℂ PositiveEnveloping r))
    (hadd : ∀ a b, P a → P b → P (a + b)) (hmul : ∀ a b, P a → P b → P (a * b))
    (u : PositiveEnveloping) : P u := by
  have hspan : LieSubalgebra.lieSpan ℂ positive (Set.univ : Set positive) = ⊤ :=
    eq_top_iff.mpr fun y _ => LieSubalgebra.subset_lieSpan (Set.mem_univ y)
  have htop := UE.adjoin_eq_top_of_lieSpan_eq_top ℂ positive Set.univ hspan
  have hu : u ∈ Algebra.adjoin ℂ ((UniversalEnvelopingAlgebra.ι ℂ) '' Set.univ) := by
    rw [htop]; trivial
  induction hu using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨y, _, rfl⟩ := hx
    exact hι y
  | algebraMap r => exact halg r
  | add a b _ _ ha hb => exact hadd a b ha hb
  | mul a b _ _ ha hb => exact hmul a b ha hb

theorem positiveUEAction_one (x : G) : positiveUEAction x 1 = 0 := by
  simp

theorem positiveUEAction_algebraMap (x : G) (r : ℂ) :
    positiveUEAction x (algebraMap ℂ PositiveEnveloping r) = 0 := by
  rw [Algebra.algebraMap_eq_smul_one, map_smul, positiveUEAction_one, smul_zero]

theorem positiveUEAction_ι (x : G) (y : positive) :
    positiveUEAction x (UniversalEnvelopingAlgebra.ι ℂ y) =
      UniversalEnvelopingAlgebra.ι ℂ (positiveConstantDerivation x y) := by
  rw [positiveUEAction_apply]
  exact TauCeti.UniversalEnvelopingAlgebra.envelopingDerivation_ι ℂ positive _ y

variable (N : Type*) [AddCommGroup N] [Module ℂ N] [LieRingModule Current N]
  [LieModule ℂ Current N]

/-- Positive currents act on the right by `n · y = -y·n`. -/
def positiveRight : positive →ₗ⁅ℂ⁆ (Module.End ℂ N)ᵐᵒᵖ where
  toFun y := op (-(LieModule.toEnd ℂ Current N (y : Current)))
  map_add' x y := by
    apply unop_injective
    simp only [LieSubmodule.coe_add, map_add, neg_add, unop_op, unop_add]
  map_smul' c x := by
    apply unop_injective
    simp only [LieSubmodule.coe_smul, map_smul, unop_op, unop_smul, RingHom.id_apply, smul_neg]
  map_lie' := by
    intro x y
    apply unop_injective
    simp only [unop_op, Ring.lie_def, unop_sub, unop_mul]
    rw [show ((⁅x, y⁆ : positive) : Current) = ⁅(x : Current), (y : Current)⁆ from rfl,
      LieHom.map_lie, Ring.lie_def, neg_mul_neg, neg_mul_neg]
    abel

/-- The right action of `U(𝔩₊)` on `N`. -/
def rightAction : PositiveEnveloping →ₐ[ℂ] (Module.End ℂ N)ᵐᵒᵖ :=
  UniversalEnvelopingAlgebra.lift ℂ (positiveRight N)

theorem ract_ι (y : positive) (n : N) :
    ract (rightAction N) (UniversalEnvelopingAlgebra.ι ℂ y) n = -⁅(y : Current), n⁆ := by
  rw [ract, rightAction, UniversalEnvelopingAlgebra.lift_ι_apply]
  rfl

theorem ract_algebraMap (r : ℂ) (n : N) :
    ract (rightAction N) (algebraMap ℂ PositiveEnveloping r) n = r • n := by
  simp [ract, AlgHom.commutes]

/-- **Compatibility with the constant `𝔰𝔩₂`.** -/
theorem ract_constant (x : G) (u : PositiveEnveloping) (n : N) :
    ⁅constant x, ract (rightAction N) u n⁆ - ract (rightAction N) u ⁅constant x, n⁆ =
      ract (rightAction N) (positiveUEAction x u) n := by
  revert n
  refine positiveUE_induction (P := fun u => ∀ n : N, ⁅constant x, ract (rightAction N) u n⁆ -
    ract (rightAction N) u ⁅constant x, n⁆ = ract (rightAction N) (positiveUEAction x u) n)
    ?_ ?_ ?_ ?_ u
  · intro y n
    rw [positiveUEAction_ι, ract_ι, ract_ι, ract_ι, positiveConstantDerivation_coe, lie_neg,
      leibniz_lie]
    abel
  · intro r n
    rw [positiveUEAction_algebraMap, ract_algebraMap, ract_algebraMap, ract_zero,
      LinearMap.zero_apply, lie_smul, sub_self]
  · intro a b ha hb n
    rw [ract_add, LinearMap.add_apply, LinearMap.add_apply, map_add, ract_add,
      LinearMap.add_apply, lie_add, ← ha, ← hb]
    abel
  · intro a b ha hb n
    rw [positiveUEAction_mul, ract_add, LinearMap.add_apply, ract_mul_apply, ract_mul_apply,
      ract_mul_apply, ract_mul_apply, ← hb (ract (rightAction N) a n), ← ha n, map_sub]
    abel

/-- The right action commutes with every operator on `N` that commutes with the positive
currents. -/
theorem ract_commute {XN : Module.End ℂ N} (hX : ∀ (y : positive) (n : N),
    XN ⁅(y : Current), n⁆ = ⁅(y : Current), XN n⁆) (u : PositiveEnveloping) (n : N) :
    XN (ract (rightAction N) u n) = ract (rightAction N) u (XN n) := by
  revert n
  refine positiveUE_induction (P := fun u => ∀ n : N,
    XN (ract (rightAction N) u n) = ract (rightAction N) u (XN n)) ?_ ?_ ?_ ?_ u
  · intro y n
    rw [ract_ι, ract_ι, map_neg, hX]
  · intro r n
    rw [ract_algebraMap, ract_algebraMap, map_smul]
  · intro a b ha hb n
    rw [ract_add, LinearMap.add_apply, LinearMap.add_apply, map_add, ha, hb]
  · intro a b ha hb n
    rw [ract_mul_apply, ract_mul_apply, hb, ha]

end KhanSL2.BGGBridge
