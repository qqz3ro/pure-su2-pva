module

public import KhanSL2.BGGBridge.TopLadder
public import KhanSL2.BGGBridge.TopWeights
public import KhanSL2.BGGBridge.TermVanishing

@[expose] public section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000

/-! # Spanning the top BGG term by extremal coefficient tensors -/

noncomputable section
open scoped TensorProduct
namespace KhanSL2.BGGBridge
open KhanSL2.BGG KhanSL2.Current

private theorem top_matrix_h_eq_tau : MatrixSL2.h = TauCeti.slFinTwoBasis ℂ 2 := by
  apply Subtype.ext
  rw [TauCeti.slFinTwoBasis_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [MatrixSL2.h]

private theorem top_matrix_e_eq_tau : MatrixSL2.e = TauCeti.slFinTwoBasis ℂ 0 := by
  apply Subtype.ext
  rw [TauCeti.slFinTwoBasis_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [MatrixSL2.e]

/-- The bottom standard vector and top coefficient space span all top-degree
standard tensors, modulo the actual diagonal constant-action relations. -/
theorem standardTensorMap_top_mem (B : ℕ) (W : Submodule ℂ (HarmN NB))
    (hrel : relH NB ≤ W)
    (htop : ∀ q, q ∈ coefficientTopSubspace B →
      standardTensorMap B (TauCeti.Sl2Std.basisVector ℂ (2*B) (2*B)) q ∈ W)
    (v : TauCeti.Sl2Std ℂ (2*B)) (ν : NB)
    (hν : LieChains.derivExt (1 : Module.End ℂ Cur) ν = (B : ℂ) • ν) :
    standardTensorMap B v ν ∈ W := by
  let P := Module.End.eigenspace (LieChains.derivExt (1 : Module.End ℂ Cur)) (B : ℂ)
  let H := LieModule.toEnd ℂ Cur NB (constant MatrixSL2.h)
  let E := LieModule.toEnd ℂ Cur NB (constant MatrixSL2.e)
  apply standard_bilinear_mem_of_shift_modulo (2*B) P (coefficientTopSubspace B) W H E
    (standardTensorMap B) ?_ ?_ ?_ ?_ htop v ν
    (Module.End.mem_eigenspace_iff.mpr hν)
  · intro w x _
    have hh := standardTensorMap_lie_mem B MatrixSL2.h w x
    have he : ⁅MatrixSL2.h, w⁆ = TauCeti.Sl2Std.diag ℂ (2*B) w := by
      rw [top_matrix_h_eq_tau, TauCeti.Sl2Std.lie_slFinTwoBasis_two]
    rw [he] at hh
    exact hrel hh
  · intro w x _
    have hh := standardTensorMap_lie_mem B MatrixSL2.e w x
    have he : ⁅MatrixSL2.e, w⁆ = TauCeti.Sl2Std.raise ℂ (2*B) w := by
      rw [top_matrix_e_eq_tau, TauCeti.Sl2Std.lie_slFinTwoBasis_zero]
    rw [he] at hh
    exact hrel hh
  · intro x hx
    have hx' := Module.End.mem_eigenspace_iff.mp hx
    apply Module.End.mem_eigenspace_iff.mpr
    change LieChains.derivExt (1 : Module.End ℂ Cur) ⁅constant MatrixSL2.e, x⁆ =
      (B : ℂ) • ⁅constant MatrixSL2.e, x⁆
    rw [coefficientNumber_lie, hx', lie_smul]
  · intro x hx
    obtain ⟨y, hy, q, hq, he⟩ := coefficient_top_cartan_decomposition B x
      (Module.End.mem_eigenspace_iff.mp hx)
    refine ⟨y, Module.End.mem_eigenspace_iff.mpr hy, q, hq, ?_⟩
    change ⁅constant MatrixSL2.h, y⁆ - ((2*B : ℕ) : ℂ) • y + q = x
    rw [Nat.cast_mul, Nat.cast_ofNat]
    exact he

/-- The extremal standard tensors span every pure tensor in top harmonic degree. -/
theorem tmul_top_mem (B : ℕ) (W : Submodule ℂ (HarmN NB))
    (hrel : relH NB ≤ W)
    (htop : ∀ q, q ∈ coefficientTopSubspace B →
      standardTensorMap B (TauCeti.Sl2Std.basisVector ℂ (2*B) (2*B)) q ∈ W)
    (h : PositiveCE.Harmonic) (hh : h ∈ degH B) (ν : NB)
    (hν : LieChains.derivExt (1 : Module.End ℂ Cur) ν = (B : ℂ) • ν) :
    h ⊗ₜ[ℂ] ν ∈ W := by
  let e := PositiveCE.harmonicDegreeStandardEquiv B
  have he : PositiveCE.standardHarmonicEmbedding B (e ⟨h, hh⟩) = h :=
    congrArg Subtype.val (e.symm_apply_apply ⟨h, hh⟩)
  have hm := standardTensorMap_top_mem B W hrel htop (e ⟨h, hh⟩) ν hν
  rw [standardTensorMap_apply, he] at hm
  exact hm

/-- Every actual top harmonic window is generated by bottom harmonic vectors
with extremal coefficients, together with diagonal constant-action relations. -/
theorem harmWin_top_le (B : ℕ) (S : ℤ) (W : Submodule ℂ (HarmN NB))
    (hrel : relH NB ≤ W)
    (htop : ∀ q, q ∈ coefficientTopSubspace B →
      standardTensorMap B (TauCeti.Sl2Std.basisVector ℂ (2*B) (2*B)) q ∈ W) :
    harmWin B B S ≤ W :=
  harmWin_le_of_tmul B B S W (tmul_top_mem B W hrel htop)

end KhanSL2.BGGBridge
