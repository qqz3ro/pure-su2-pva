module

public import KhanSL2.SymmetricFamily.RootFactorAlgebra
public import Mathlib.RingTheory.Finiteness.Ideal
public import Mathlib.RingTheory.Nilpotent.Lemmas

@[expose] public section
set_option backward.isDefEq.respectTransparency false

/-! The actual one-point labelled-root fibre has a nilpotent displacement ideal.
This supplies a finite algebraic filtration without any regular-representation input. -/

noncomputable section
open Polynomial
open scoped BigOperators
namespace KhanSL2.SymmetricFamily

/-- The labelled-root fibre over the monic polynomial (X-a)^k. -/
abbrev LocalRootAlgebra (k : ℕ) (a : ℂ) := FactorRoots k ((Polynomial.X - Polynomial.C a)^k)

/-- The actual one-point labelled-root algebra is finite dimensional. -/
theorem localRootAlgebra_finite (k : ℕ) (a : ℂ) :
    Module.Finite ℂ (LocalRootAlgebra k a) := by
  unfold LocalRootAlgebra FactorRoots
  infer_instance

/-- Original labelled roots in the one-point fibre. -/
def localRoot (k : ℕ) (a : ℂ) (i : Fin k) : LocalRootAlgebra k a :=
  factorRoot k ((Polynomial.X - Polynomial.C a)^k) i

/-- Displacements from the actual support point. -/
def localDisplacement (k : ℕ) (a : ℂ) (i : Fin k) : LocalRootAlgebra k a :=
  localRoot k a i - algebraMap ℂ (LocalRootAlgebra k a) a

/-- The full characteristic-polynomial identity in the actual fibre. -/
theorem localRoot_product (k : ℕ) (a : ℂ) :
    ∏ i : Fin k, (Polynomial.X - Polynomial.C (localRoot k a i)) =
      (Polynomial.X - Polynomial.C (algebraMap ℂ (LocalRootAlgebra k a) a))^k := by
  have h := factorRoot_product k ((Polynomial.X - Polynomial.C a)^k)
    ((Polynomial.monic_X_sub_C a).pow k) (by simp)
  simpa only [Polynomial.map_pow, Polynomial.map_sub, Polynomial.map_X,
    Polynomial.map_C, localRoot] using h

/-- Each labelled displacement is nilpotent with the explicit exponent k. -/
theorem localDisplacement_pow (k : ℕ) (a : ℂ) (i : Fin k) :
    localDisplacement k a i ^ k = 0 := by
  have h := congrArg (Polynomial.eval (localRoot k a i)) (localRoot_product k a)
  simp only [Polynomial.eval_prod, Polynomial.eval_sub, Polynomial.eval_X,
    Polynomial.eval_C, Polynomial.eval_pow] at h
  have hz : ∏ j : Fin k, (localRoot k a i-localRoot k a j) = 0 :=
    Finset.prod_eq_zero (Finset.mem_univ i) (sub_self _)
  exact h.symm.trans hz

/-- The finite ideal generated by the labelled displacements. -/
def localRootIdeal (k : ℕ) (a : ℂ) : Ideal (LocalRootAlgebra k a) :=
  Ideal.span (Set.range (localDisplacement k a))

theorem localDisplacement_mem (k : ℕ) (a : ℂ) (i : Fin k) :
    localDisplacement k a i ∈ localRootIdeal k a :=
  Ideal.subset_span ⟨i,rfl⟩

/-- The actual displacement filtration terminates. -/
theorem localRootIdeal_nilpotent (k : ℕ) (a : ℂ) : IsNilpotent (localRootIdeal k a) := by
  have hfg : (localRootIdeal k a).FG :=
    Submodule.fg_span (Set.finite_range (localDisplacement k a))
  have hle : localRootIdeal k a ≤ (⊥ : Ideal (LocalRootAlgebra k a)).radical := by
    apply Ideal.span_le.mpr
    rintro x ⟨i,rfl⟩
    exact ⟨k,localDisplacement_pow k a i⟩
  obtain ⟨n,hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hle hfg
  exact ⟨n,le_bot_iff.mp hn⟩

/-- The actual evaluation at the support point. -/
def localRootEvaluation (k : ℕ) (a : ℂ) : LocalRootAlgebra k a →ₐ[ℂ] ℂ :=
  factorRootsLift k ((Polynomial.X - Polynomial.C a)^k)
    ((Polynomial.monic_X_sub_C a).pow k) (by simp) (fun _ => a) (by simp)

@[simp] theorem localRootEvaluation_root (k : ℕ) (a : ℂ) (i : Fin k) :
    localRootEvaluation k a (localRoot k a i) = a :=
  factorRootsLift_factorRoot _ _ _ _ _ _ i

@[simp] theorem localRootEvaluation_displacement (k : ℕ) (a : ℂ) (i : Fin k) :
    localRootEvaluation k a (localDisplacement k a i) = 0 := by
  simp only [localDisplacement, map_sub, localRootEvaluation_root, AlgHom.commutes,
    Algebra.algebraMap_self, RingHom.id_apply, sub_self]

theorem localRootIdeal_le_ker (k : ℕ) (a : ℂ) :
    localRootIdeal k a ≤ RingHom.ker (localRootEvaluation k a).toRingHom := by
  apply Ideal.span_le.mpr
  rintro x ⟨i,rfl⟩
  exact localRootEvaluation_displacement k a i

end KhanSL2.SymmetricFamily
