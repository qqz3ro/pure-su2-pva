module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.LinearAlgebra.Quotient.Defs

@[expose] public section

/-! A coefficient-linear retraction descends through compatible relations.
This is used to descend the alternating section through diagonal Lie algebra
coinvariants, keeping the coefficient ring unchanged. -/

noncomputable section
namespace KhanSL2.PolynomialBGG

section QuotientRetract

variable {R E F : Type*} [CommRing R]
  [AddCommGroup E] [Module R E] [AddCommGroup F] [Module R F]

/-- A split pair of maps remains split after passage to compatible quotients. -/
theorem mapQ_comp_mapQ_of_split (A : Submodule R E) (B : Submodule R F)
    (i : F →ₗ[R] E) (r : E →ₗ[R] F) (hri : r.comp i = LinearMap.id)
    (hi : B ≤ A.comap i) (hr : A ≤ B.comap r) :
    (A.mapQ B r hr).comp (B.mapQ A i hi) = LinearMap.id := by
  apply Submodule.linearMap_qext
  apply LinearMap.ext
  intro x
  change B.mkQ (r (i x)) = B.mkQ x
  exact congrArg B.mkQ (LinearMap.congr_fun hri x)

/-- Projectivity of the larger coinvariant quotient passes to a retract. -/
theorem quotient_projective_of_split (A : Submodule R E) (B : Submodule R F)
    [Module.Projective R (E ⧸ A)]
    (i : F →ₗ[R] E) (r : E →ₗ[R] F) (hri : r.comp i = LinearMap.id)
    (hi : B ≤ A.comap i) (hr : A ≤ B.comap r) : Module.Projective R (F ⧸ B) :=
  Module.Projective.of_split (B.mapQ A i hi) (A.mapQ B r hr)
    (mapQ_comp_mapQ_of_split A B i r hri hi hr)

/-- Relations generated by a family of linear operators. -/
def actionRelations {I : Type*} (a : I → Module.End R E) : Submodule R E :=
  ⨆ x, LinearMap.range (a x)

/-- An intertwining linear map sends action relations to action relations. -/
theorem actionRelations_le_comap {I : Type*}
    (a : I → Module.End R E) (b : I → Module.End R F) (f : E →ₗ[R] F)
    (hf : ∀ x, f.comp (a x) = (b x).comp f) :
    actionRelations a ≤ (actionRelations b).comap f := by
  refine iSup_le fun x => ?_
  rintro _ ⟨z, rfl⟩
  change f (a x z) ∈ actionRelations b
  rw [show f (a x z) = b x (f z) from LinearMap.congr_fun (hf x) z]
  exact Submodule.mem_iSup_of_mem x ⟨f z, rfl⟩

/-- An equivariant linear retract remains a retract on action coinvariants. -/
theorem actionCoinvariants_projective_of_split {I : Type*}
    (a : I → Module.End R E) (b : I → Module.End R F)
    [Module.Projective R (E ⧸ actionRelations a)]
    (i : F →ₗ[R] E) (r : E →ₗ[R] F) (hri : r.comp i = LinearMap.id)
    (hi : ∀ x, i.comp (b x) = (a x).comp i)
    (hr : ∀ x, r.comp (a x) = (b x).comp r) :
    Module.Projective R (F ⧸ actionRelations b) :=
  quotient_projective_of_split (actionRelations a) (actionRelations b) i r hri
    (actionRelations_le_comap b a i hi) (actionRelations_le_comap a b r hr)

end QuotientRetract

end KhanSL2.PolynomialBGG
